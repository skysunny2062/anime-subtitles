Dialogue: 0,0:01:58.01,0:02:02.02,TITLE 方正粗雅宋_GBK,,0,0,0,,{\fsp71\pos(870,1050)}渚課
Dialogue: 0,0:18:59.45,0:19:01.99,OTHERS 微软雅黑,,0,0,0,,{\fad(667,0)\fs100\fsp50\move(950,450,375,450)}最愛夏{\fsp}天！
Dialogue: 0,0:00:16.56,0:00:17.89,TW,,0,0,0,,我要殺了你
Dialogue: 0,0:00:18.72,0:00:20.29,TW,,0,0,0,,你居然敢把大家…
Dialogue: 0,0:00:21.94,0:00:25.48,TW,,0,0,0,,要的就是這種氣勢 來殺我吧
Dialogue: 0,0:00:25.65,0:00:27.70,TW,,0,0,0,,渚
Dialogue: 0,0:02:05.83,0:02:08.26,TW,,0,0,0,,渚真的生氣了
Dialogue: 0,0:02:08.58,0:02:12.06,TW,,0,0,0,,雖然我們也很想殺了那個人渣
Dialogue: 0,0:02:12.40,0:02:15.96,TW,,0,0,0,,不過 渚是打算來真的嗎
Dialogue: 0,0:02:16.26,0:02:18.34,TW,,0,0,0,,不行 快點阻止渚…
Dialogue: 0,0:02:26.22,0:02:28.90,TW,,0,0,0,,渚 你算哪根蔥啦
Dialogue: 0,0:02:30.23,0:02:32.19,TW,,0,0,0,,解藥被炸掉的時候
Dialogue: 0,0:02:32.38,0:02:35.36,TW,,0,0,0,,你用憐憫的眼神看了我一眼吧
Dialogue: 0,0:02:36.96,0:02:41.63,TW,,0,0,0,,別有點本事了就替人瞎操心 你這個豆芽菜
Dialogue: 0,0:02:42.05,0:02:45.91,TW,,0,0,0,,這點病毒 我睡上一覺就沒事了
Dialogue: 0,0:02:45.94,0:02:48.34,TW,,0,0,0,,寺坂…你難道…
Dialogue: 0,0:02:48.56,0:02:52.80,TW,,0,0,0,,就算這傢伙死不足惜 要了他命的話你就成了殺人犯了
Dialogue: 0,0:02:53.14,0:02:57.72,TW,,0,0,0,,你為了出這口惡氣 不惜放棄拿100億的希望嗎
Dialogue: 0,0:02:57.88,0:03:00.47,TW,,0,0,0,,渚同學 寺坂同學說得沒錯
Dialogue: 0,0:03:00.74,0:03:03.25,TW,,0,0,0,,這個人不值得你去殺
Dialogue: 0,0:03:03.42,0:03:05.66,TW,,0,0,0,,怒火中燒只會讓你陷入不利
Dialogue: 0,0:03:05.86,0:03:09.38,TW,,0,0,0,,況且 他對解藥根本就不瞭解
Dialogue: 0,0:03:09.55,0:03:12.05,TW,,0,0,0,,我們去找樓下那個使毒的問清楚就好了
Dialogue: 0,0:03:12.45,0:03:15.70,TW,,0,0,0,,至於這個人 弄暈他就夠了
Dialogue: 0,0:03:15.90,0:03:19.36,TW,,0,0,0,,喂喂 別來給我搗亂
Dialogue: 0,0:03:19.42,0:03:22.74,TW,,0,0,0,,他不玩真的的話還有什麼意義
Dialogue: 0,0:03:23.09,0:03:28.00,TW,,0,0,0,,只有狠狠蹂躪了這小鬼發自肺腑的殺意
Dialogue: 0,0:03:28.00,0:03:30.88,TW,,0,0,0,,我才能一雪前恥
Dialogue: 0,0:03:30.96,0:03:34.54,TW,,0,0,0,,渚同學 把寺坂同學的電擊槍撿起來
Dialogue: 0,0:03:37.07,0:03:39.64,TW,,0,0,0,,他的命和為師的命
Dialogue: 0,0:03:39.88,0:03:42.75,TW,,0,0,0,,他說的話和寺坂同學說的話
Dialogue: 0,0:03:43.08,0:03:46.45,TW,,0,0,0,,哪邊更有分量 你自己考慮清楚
Dialogue: 0,0:03:47.82,0:03:48.72,TW,,0,0,0,,寺坂
Dialogue: 0,0:03:49.08,0:03:51.63,TW,,0,0,0,,你燒得太厲害了
Dialogue: 0,0:03:51.63,0:03:53.76,TW,,0,0,0,,你就這麼撐到現在嗎
Dialogue: 0,0:03:54.45,0:03:55.94,TW,,0,0,0,,別管我…
Dialogue: 0,0:03:56.12,0:03:58.75,TW,,0,0,0,,現在該看的 是那邊
Dialogue: 0,0:03:59.66,0:04:01.17,TW,,0,0,0,,上吧 渚
Dialogue: 0,0:04:01.66,0:04:05.16,TW,,0,0,0,,狠狠揍他…揍到只剩最後一口氣
Dialogue: 0,0:04:22.14,0:04:23.89,TW,,0,0,0,,真帥氣欸
Dialogue: 0,0:04:23.89,0:04:27.42,TW,,0,0,0,,殺老師 渚把電擊槍收到腰間了
Dialogue: 0,0:04:28.93,0:04:33.33,TW,,0,0,0,,看來你是打算用匕首的呢 那我就放心了
Dialogue: 0,0:04:33.44,0:04:35.23,TW,,0,0,0,,先告訴你一聲
Dialogue: 0,0:04:35.35,0:04:37.84,TW,,0,0,0,,我這裡有備用的解藥
Dialogue: 0,0:04:37.86,0:04:41.32,TW,,0,0,0,,要是你不玩真的來殺我
Dialogue: 0,0:04:41.32,0:04:44.48,TW,,0,0,0,,或者下面那幫人來搗亂的話
Dialogue: 0,0:04:44.55,0:04:46.79,TW,,0,0,0,,我就把這些也毀掉
Dialogue: 0,0:04:47.57,0:04:51.35,TW,,0,0,0,,烏間 你可別來攪局哦
Dialogue: 0,0:04:52.38,0:04:55.39,TW,,0,0,0,,製作這種解藥 好像得要花上一個月呢
Dialogue: 0,0:04:55.51,0:05:00.42,TW,,0,0,0,,雖然不夠你們分 但這可是最後的希望喔
Dialogue: 0,0:05:01.82,0:05:03.10,TW,,0,0,0,,烏間老師
Dialogue: 0,0:05:03.70,0:05:07.55,TW,,0,0,0,,如果你覺得渚有生命危險
Dialogue: 0,0:05:07.67,0:05:10.14,TW,,0,0,0,,請果斷對鷹岡老師開槍
Dialogue: 0,0:05:11.64,0:05:15.45,TW,,0,0,0,,它凡事都胸有成竹 現在竟然說到這個份上…
Dialogue: 0,0:05:15.97,0:05:18.80,TW,,0,0,0,,看來這次我們面臨著前所未有的危險
Dialogue: 0,0:05:19.62,0:05:22.99,TW,,0,0,0,,就算他不說 我也覺得目前的情況非常不妙
Dialogue: 0,0:05:23.66,0:05:29.29,TW,,0,0,0,,我們好不容易主導戰局 打敗了之前的三名殺手
Dialogue: 0,0:05:29.63,0:05:32.16,TW,,0,0,0,,但是現在情況完全相反
Dialogue: 0,0:05:33.42,0:05:36.50,TW,,0,0,0,,就算潮田渚率先出手暗殺…
Dialogue: 0,0:05:43.06,0:05:44.95,TW,,0,0,0,,喂 怎麼了
Dialogue: 0,0:05:45.02,0:05:47.28,TW,,0,0,0,,來殺我啊
Dialogue: 0,0:05:49.44,0:05:52.00,TW,,0,0,0,,如今的鷹岡不同以往
Dialogue: 0,0:05:52.62,0:05:54.46,TW,,0,0,0,,他從一開始就進入了戰鬥狀態
Dialogue: 0,0:05:54.84,0:05:58.14,TW,,0,0,0,,就算已經喪心病狂 他仍是一名優秀的軍人
Dialogue: 0,0:05:58.69,0:06:01.43,TW,,0,0,0,,他的防禦滴水不漏 任何奇襲都不管用
Dialogue: 0,0:06:05.50,0:06:06.39,TW,,0,0,0,,不管從體格
Dialogue: 0,0:06:06.56,0:06:07.35,TW,,0,0,0,,從技術
Dialogue: 0,0:06:07.63,0:06:08.54,TW,,0,0,0,,還是從經驗
Dialogue: 0,0:06:14.48,0:06:18.94,TW,,0,0,0,,要贏他 比全國模擬考試拿第一還難上數倍
Dialogue: 0,0:06:19.55,0:06:21.16,TW,,0,0,0,,根本就沒辦法比
Dialogue: 0,0:06:21.16,0:06:23.92,TW,,0,0,0,,怎麼可能贏得了這種怪物啦
Dialogue: 0,0:06:24.14,0:06:29.09,TW,,0,0,0,,喂喂 你可別趴下唷 剛才還只是熱身運動而已
Dialogue: 0,0:06:30.58,0:06:34.68,TW,,0,0,0,,接下來 我差不多也該上傢伙了吧
Dialogue: 0,0:06:37.36,0:06:40.73,TW,,0,0,0,,有一道陰影 會和匕首一起出現在我夢裡
Dialogue: 0,0:06:41.29,0:06:44.19,TW,,0,0,0,,就是他那時的笑容
Dialogue: 0,0:06:44.38,0:06:48.20,TW,,0,0,0,,自從被那個笑容殺了個措手不及 一切就亂了套
Dialogue: 0,0:06:48.61,0:06:52.38,TW,,0,0,0,,我絕不會重蹈覆轍
Dialogue: 0,0:06:52.92,0:06:56.41,TW,,0,0,0,,我要把你的手腳切下來做成標本
Dialogue: 0,0:06:56.41,0:07:00.20,TW,,0,0,0,,隨身攜帶 隨時賞玩
Dialogue: 0,0:07:00.65,0:07:03.32,TW,,0,0,0,,烏間老師 快開槍吧
Dialogue: 0,0:07:03.40,0:07:05.20,TW,,0,0,0,,這樣下去的話 渚會沒命的
Dialogue: 0,0:07:05.46,0:07:08.25,TW,,0,0,0,,等等 你們別出手
Dialogue: 0,0:07:08.58,0:07:10.86,TW,,0,0,0,,你還看得下去嗎 寺坂
Dialogue: 0,0:07:11.33,0:07:14.15,TW,,0,0,0,,連我都想出手參戰了
Dialogue: 0,0:07:14.27,0:07:19.94,TW,,0,0,0,,業…你總是翹掉訓練 所以不知道吧
Dialogue: 0,0:07:20.24,0:07:21.75,TW,,0,0,0,,渚這小子
Dialogue: 0,0:07:22.41,0:07:25.59,TW,,0,0,0,,好像還留了一手
Dialogue: 0,0:07:26.47,0:07:29.04,TW,,0,0,0,,剛才的就是…必殺技
Dialogue: 0,0:07:29.27,0:07:33.92,TW,,0,0,0,,沒錯…話雖這麼說 你肯定摸不著頭腦吧
Dialogue: 0,0:07:34.37,0:07:36.63,TW,,0,0,0,,我在殺手生涯中遇到危機時
Dialogue: 0,0:07:36.81,0:07:39.55,TW,,0,0,0,,急中生智想出了這招 並化險為夷
Dialogue: 0,0:07:40.32,0:07:43.14,TW,,0,0,0,,這一招並不是隨時都能用的
Dialogue: 0,0:07:43.62,0:07:46.02,TW,,0,0,0,,大致有三個條件需要滿足
Dialogue: 0,0:07:46.89,0:07:50.29,TW,,0,0,0,,第一 必須持有兩種武器
Dialogue: 0,0:07:51.33,0:07:54.64,TW,,0,0,0,,第二 敵人必須是練武之人
Dialogue: 0,0:07:55.05,0:07:59.69,TW,,0,0,0,,第三 敵人體會過被殺時的恐懼
Dialogue: 0,0:08:01.28,0:08:02.36,TW,,0,0,0,,太好了
Dialogue: 0,0:08:03.78,0:08:05.31,TW,,0,0,0,,條件全都滿足了
Dialogue: 0,0:08:06.93,0:08:07.88,TW,,0,0,0,,怎麼回事
Dialogue: 0,0:08:08.32,0:08:09.73,TW,,0,0,0,,鷹岡老師
Dialogue: 0,0:08:11.95,0:08:13.74,TW,,0,0,0,,成為我的小白鼠吧
Dialogue: 0,0:08:16.28,0:08:17.89,TW,,0,0,0,,他要幹什麼
Dialogue: 0,0:08:18.88,0:08:23.48,TW,,0,0,0,,雖說是必殺技 但並不是「必殺」的一招
Dialogue: 0,0:08:23.96,0:08:30.04,TW,,0,0,0,,理想狀態下 「必殺」對暗殺者來說本來就是理所當然
Dialogue: 0,0:08:30.22,0:08:33.06,TW,,0,0,0,,但是 實際操作並不會那麼順利
Dialogue: 0,0:08:33.27,0:08:36.39,TW,,0,0,0,,當目標是個無懈可擊的高手時就更難得手
Dialogue: 0,0:08:36.75,0:08:42.14,TW,,0,0,0,,不過 有一招能在危機之時創造出「必殺」的理想狀況
Dialogue: 0,0:08:42.27,0:08:46.12,TW,,0,0,0,,就是這個為「必殺」而準備的招數
Dialogue: 0,0:08:46.24,0:08:49.03,TW,,0,0,0,,為必殺…而準備的
Dialogue: 0,0:08:49.58,0:08:52.17,TW,,0,0,0,,毫無徵兆地 以最快速度出手
Dialogue: 0,0:08:52.33,0:08:55.04,TW,,0,0,0,,伸到最遠 擊出最響…
Dialogue: 0,0:08:56.20,0:08:59.73,TW,,0,0,0,,臭小鬼
Dialogue: 0,0:08:59.93,0:09:03.23,TW,,0,0,0,,時機就是匕首落下的那瞬間
Dialogue: 0,0:09:03.92,0:09:07.03,TW,,0,0,0,,距離越近 敵人的注意力就越集中在匕首上
Dialogue: 0,0:09:09.11,0:09:13.14,TW,,0,0,0,,把所有注意力 一起隨匕首拋向一邊
Dialogue: 0,0:09:13.54,0:09:14.71,TW,,0,0,0,,就這樣…
Dialogue: 0,0:09:36.63,0:09:39.51,TW,,0,0,0,,發…發生了什麼事…
Dialogue: 0,0:09:40.30,0:09:44.29,TW,,0,0,0,,暗殺者不會放過這個瞬間
Dialogue: 0,0:09:44.76,0:09:48.54,TW,,0,0,0,,如行雲流水般 迅速拔出第二把武器秒殺對方
Dialogue: 0,0:09:51.56,0:09:53.80,TW,,0,0,0,,怎麼可能…
Dialogue: 0,0:09:56.05,0:10:00.76,TW,,0,0,0,,居然被這小鬼…幹掉兩次…
Dialogue: 0,0:10:15.06,0:10:17.07,TW,,0,0,0,,渚 給他最後一擊
Dialogue: 0,0:10:17.57,0:10:22.37,TW,,0,0,0,,狠狠地電擊脖子附近 他就會完全暈厥
Dialogue: 0,0:10:32.80,0:10:34.45,TW,,0,0,0,,他教會了我殺意
Dialogue: 0,0:10:35.35,0:10:38.51,TW,,0,0,0,,讓我懂得 有種殺意絕不可取
Dialogue: 0,0:10:39.23,0:10:43.22,TW,,0,0,0,,還有 把我從那種殺意中拉回來的朋友有多珍貴…
Dialogue: 0,0:10:44.10,0:10:47.50,TW,,0,0,0,,讓我體會了被打的痛苦 還有實戰的恐懼
Dialogue: 0,0:10:48.02,0:10:50.23,TW,,0,0,0,,這個人教會了我很多
Dialogue: 0,0:10:51.02,0:10:52.91,TW,,0,0,0,,儘管你做了不少殘酷的事
Dialogue: 0,0:10:53.15,0:10:58.41,TW,,0,0,0,,但與此無關 我必須好好感謝你的教導
Dialogue: 0,0:11:01.75,0:11:03.38,TW,,0,0,0,,要傳達謝意的話…
Dialogue: 0,0:11:03.79,0:11:04.90,TW,,0,0,0,,不要…
Dialogue: 0,0:11:05.26,0:11:07.74,TW,,0,0,0,,就應該用這種表情
Dialogue: 0,0:11:08.73,0:11:12.60,TW,,0,0,0,,唯獨不要用那個表情來結束一切啦
Dialogue: 0,0:11:13.57,0:11:19.35,TW,,0,0,0,,我這輩子都走不出這張笑臉的陰影了啦
Dialogue: 0,0:11:20.47,0:11:21.79,TW,,0,0,0,,鷹岡老師
Dialogue: 0,0:11:23.30,0:11:24.91,TW,,0,0,0,,多謝您的指導
Dialogue: 0,0:11:43.04,0:11:46.43,TW,,0,0,0,,太棒了 大魔王被打倒了
Dialogue: 0,0:11:46.43,0:11:48.16,TW,,0,0,0,,太好了
Dialogue: 0,0:12:09.15,0:12:10.18,TW,,0,0,0,,做得漂亮
Dialogue: 0,0:12:11.05,0:12:12.46,TW,,0,0,0,,渚 你沒事吧
Dialogue: 0,0:12:13.43,0:12:16.27,TW,,0,0,0,,渚同學 你做得非常好
Dialogue: 0,0:12:16.51,0:12:20.32,TW,,0,0,0,,為師真的以為這次要出事了 但現在放心了
Dialogue: 0,0:12:20.64,0:12:23.36,TW,,0,0,0,,嗯 我沒事
Dialogue: 0,0:12:23.59,0:12:25.40,TW,,0,0,0,,但這可怎麼辦…
Dialogue: 0,0:12:25.94,0:12:29.10,TW,,0,0,0,,從鷹岡老師那裡搶來的藥完全不夠欸
Dialogue: 0,0:12:30.92,0:12:32.81,TW,,0,0,0,,先逃出去再說
Dialogue: 0,0:12:33.15,0:12:35.68,TW,,0,0,0,,我叫了直升機 你們在這裡等著
Dialogue: 0,0:12:36.18,0:12:38.47,TW,,0,0,0,,我去把那個使毒的帶過來
Dialogue: 0,0:12:39.62,0:12:42.51,TW,,0,0,0,,你們根本就不需要解藥
Dialogue: 0,0:12:43.02,0:12:47.22,TW,,0,0,0,,小鬼們 你們真以為還能活著回去嗎
Dialogue: 0,0:12:47.79,0:12:50.71,TW,,0,0,0,,你們的雇主已經被打敗了
Dialogue: 0,0:12:50.87,0:12:52.61,TW,,0,0,0,,你們應該沒理由繼續戰鬥了
Dialogue: 0,0:12:53.81,0:12:55.82,TW,,0,0,0,,我已經恢復得差不多了
Dialogue: 0,0:12:56.15,0:12:58.19,TW,,0,0,0,,學生們也很強
Dialogue: 0,0:12:58.81,0:13:02.01,TW,,0,0,0,,就別給彼此增加不必要的傷亡了
Dialogue: 0,0:13:02.25,0:13:03.74,TW,,0,0,0,,嗯 好啊
Dialogue: 0,0:13:03.78,0:13:05.20,TW,,0,0,0,,真難纏…
Dialogue: 0,0:13:05.20,0:13:06.83,TW,,0,0,0,,咦 答應了？
Dialogue: 0,0:13:07.11,0:13:11.41,TW,,0,0,0,,我們的契約內並不包含為老大報仇
Dialogue: 0,0:13:11.49,0:13:15.79,TW,,0,0,0,,而且不是說了嗎 你們根本就不需要解藥
Dialogue: 0,0:13:17.33,0:13:22.72,TW,,0,0,0,,給你們下的其實是這個經過改良的食物中毒菌
Dialogue: 0,0:13:22.99,0:13:25.47,TW,,0,0,0,,雖然還會持續肆虐三個小時左右
Dialogue: 0,0:13:25.47,0:13:29.47,TW,,0,0,0,,但之後就會急速失去活性 變得無毒無害
Dialogue: 0,0:13:29.71,0:13:32.39,TW,,0,0,0,,老大指示我下的是這個
Dialogue: 0,0:13:33.24,0:13:36.56,TW,,0,0,0,,要是用了這個 你們就真的完了
Dialogue: 0,0:13:36.98,0:13:40.72,TW,,0,0,0,,在投毒之前 我們三個商量了一下哉
Dialogue: 0,0:13:41.01,0:13:43.37,TW,,0,0,0,,老大規定的交易時間是一小時哉
Dialogue: 0,0:13:43.87,0:13:47.82,TW,,0,0,0,,那樣的話 就算不用致命病毒也能完成交易哉
Dialogue: 0,0:13:48.19,0:13:52.48,TW,,0,0,0,,要讓你們感受到生命危險 用食物中毒菌就夠了
Dialogue: 0,0:13:52.83,0:13:55.32,TW,,0,0,0,,你們這是違抗了鷹岡的命令吧
Dialogue: 0,0:13:55.54,0:13:58.10,TW,,0,0,0,,明明是拿錢辦事 你們這樣沒問題嗎
Dialogue: 0,0:13:58.21,0:13:59.26,TW,,0,0,0,,別傻了
Dialogue: 0,0:13:59.54,0:14:02.88,TW,,0,0,0,,妳認為職業殺手為了錢就什麼都做的話 那就大錯特錯了
Dialogue: 0,0:14:03.53,0:14:07.37,TW,,0,0,0,,當然我們會盡最大的努力完成委託人的要求
Dialogue: 0,0:14:07.74,0:14:12.49,TW,,0,0,0,,我要當著他們的面 把解藥炸掉
Dialogue: 0,0:14:12.60,0:14:15.79,TW,,0,0,0,,他們絕望的表情太值得一看了
Dialogue: 0,0:14:16.42,0:14:20.21,TW,,0,0,0,,老大從一開始就不打算把解藥交給你們
Dialogue: 0,0:14:20.77,0:14:24.87,TW,,0,0,0,,是淪為殺害大量國中生的罪犯呢
Dialogue: 0,0:14:25.00,0:14:27.09,TW,,0,0,0,,還是拉低自己職業殺手的評價呢
Dialogue: 0,0:14:27.49,0:14:33.22,TW,,0,0,0,,我們只是冷靜地衡量了一下 哪一個帶來的風險更大
Dialogue: 0,0:14:34.76,0:14:39.71,TW,,0,0,0,,就是這麼回事 很遺憾你們誰都死不了
Dialogue: 0,0:14:40.50,0:14:43.79,TW,,0,0,0,,讓患者喝下這個營養劑後睡一覺吧
Dialogue: 0,0:14:43.89,0:14:47.43,TW,,0,0,0,,醒來後會比原來還有精神 都想給我寫感謝信了
Dialogue: 0,0:14:48.39,0:14:52.72,TW,,0,0,0,,我要看到學生們康復之後才能相信你們
Dialogue: 0,0:14:53.02,0:14:56.60,TW,,0,0,0,,還要問你們一些情況 暫時不能放你們走
Dialogue: 0,0:14:56.81,0:14:58.60,TW,,0,0,0,,好吧 這也沒辦法
Dialogue: 0,0:14:58.75,0:15:02.90,TW,,0,0,0,,我下週還有新任務 在這之前搞定吧
Dialogue: 0,0:15:03.50,0:15:04.67,TW,,0,0,0,,什麼嘛
Dialogue: 0,0:15:04.99,0:15:07.57,TW,,0,0,0,,不來場復仇戰嗎 哉大叔
Dialogue: 0,0:15:07.83,0:15:10.94,TW,,0,0,0,,你應該恨不得親手殺了我吧
Dialogue: 0,0:15:11.50,0:15:14.96,TW,,0,0,0,,我從不因私怨殺人哉
Dialogue: 0,0:15:16.06,0:15:19.34,TW,,0,0,0,,我會等別人委託我來殺你哉
Dialogue: 0,0:15:19.94,0:15:23.17,TW,,0,0,0,,所以 你要成為那種大人物才行哉
Dialogue: 0,0:15:23.75,0:15:26.07,TW,,0,0,0,,就是這樣 臭小鬼們
Dialogue: 0,0:15:26.36,0:15:29.61,TW,,0,0,0,,真的想讓我們動手殺你們的話 就努力成為大人物吧
Dialogue: 0,0:15:30.52,0:15:35.71,TW,,0,0,0,,到時候 可要讓你們領教一下職業殺手的一條龍服務
Dialogue: 0,0:15:42.83,0:15:44.93,TW,,0,0,0,,殺手們離開了
Dialogue: 0,0:15:45.79,0:15:48.74,TW,,0,0,0,,留下了別具風格的鼓勵…
Dialogue: 0,0:15:52.36,0:15:56.54,TW,,0,0,0,,烏間發來了一次震動 看來大家都成功逃出去了
Dialogue: 0,0:15:56.70,0:16:00.14,TW,,0,0,0,,吶 人家想去山腳下看大海
Dialogue: 0,0:16:00.19,0:16:02.33,TW,,0,0,0,,誰能開車送我去
Dialogue: 0,0:16:02.33,0:16:04.17,TW,,0,0,0,,我我我
Dialogue: 0,0:16:04.40,0:16:07.70,TW,,0,0,0,,就這樣 我們的大規模潛入行動
Dialogue: 0,0:16:07.91,0:16:11.30,TW,,0,0,0,,在酒店的人毫無察覺的情況下圓滿結束了
Dialogue: 0,0:16:13.43,0:16:14.53,TW,,0,0,0,,寺坂同學
Dialogue: 0,0:16:15.18,0:16:18.33,TW,,0,0,0,,謝謝你 要不是你叫住了我
Dialogue: 0,0:16:18.58,0:16:20.22,TW,,0,0,0,,我恐怕就要鑄成大錯了
Dialogue: 0,0:16:21.49,0:16:25.18,TW,,0,0,0,,少了一個人的話 不就更難幹掉那隻章魚了嗎
Dialogue: 0,0:16:28.38,0:16:30.18,TW,,0,0,0,,嗯 對不起
Dialogue: 0,0:16:32.16,0:16:37.76,TW,,0,0,0,,我們回到了酒店 告訴同學們已無性命之憂
Dialogue: 0,0:16:38.68,0:16:42.13,TW,,0,0,0,,各式各樣的疲勞感席捲而來 我們都酣睡如泥
Dialogue: 0,0:16:42.74,0:16:45.82,TW,,0,0,0,,醒來時已經是第二天的傍晚了
Dialogue: 0,0:16:52.92,0:16:55.92,TW,,0,0,0,,總覺得昨天還真是夠嗆的呢
Dialogue: 0,0:16:56.22,0:16:58.22,TW,,0,0,0,,大家沒事就好
Dialogue: 0,0:16:58.27,0:17:00.93,TW,,0,0,0,,你才是遇到最危險的情況的人吧
Dialogue: 0,0:17:02.08,0:17:02.96,TW,,0,0,0,,抱歉
Dialogue: 0,0:17:03.05,0:17:05.56,TW,,0,0,0,,你三不五時會身陷險境呢
Dialogue: 0,0:17:05.61,0:17:07.56,TW,,0,0,0,,大家都很擔心你喔
Dialogue: 0,0:17:08.90,0:17:11.81,TW,,0,0,0,,早安 雖說已經是傍晚了
Dialogue: 0,0:17:11.92,0:17:12.86,TW,,0,0,0,,妳沒事了嗎
Dialogue: 0,0:17:13.20,0:17:14.30,TW,,0,0,0,,多虧有你們在
Dialogue: 0,0:17:14.38,0:17:16.53,TW,,0,0,0,,大家果然都穿著運動服呢
Dialogue: 0,0:17:16.65,0:17:19.79,TW,,0,0,0,,反正也沒有其他客人在 這樣最方便
Dialogue: 0,0:17:19.79,0:17:23.23,TW,,0,0,0,,要幫全班畫兩套便服太燒腦細胞了
Dialogue: 0,0:17:23.37,0:17:24.72,TW,,0,0,0,,瞎說什麼大實話
Dialogue: 0,0:17:24.94,0:17:27.05,TW,,0,0,0,,殺老師在那裡面嗎
Dialogue: 0,0:17:27.94,0:17:32.44,TW,,0,0,0,,雖然沒抱什麼希望 不過為了殺它 還是得先埋結實了
Dialogue: 0,0:17:32.53,0:17:35.42,TW,,0,0,0,,烏間老師沒有休息 一直在指揮工作
Dialogue: 0,0:17:35.60,0:17:37.98,TW,,0,0,0,,完全不顯疲倦 真是太厲害了
Dialogue: 0,0:17:37.98,0:17:39.69,TW,,0,0,0,,真了不起
Dialogue: 0,0:17:39.90,0:17:43.42,TW,,0,0,0,,十年後 我們也能成為像他那樣的超人嗎
Dialogue: 0,0:17:43.42,0:17:44.63,TW,,0,0,0,,誰知道呢
Dialogue: 0,0:17:44.73,0:17:47.88,TW,,0,0,0,,別看碧琪老師那樣 其實也很厲害
Dialogue: 0,0:17:48.16,0:17:50.44,TW,,0,0,0,,在酒店裡遇到的那群殺手也是如此
Dialogue: 0,0:17:50.84,0:17:53.84,TW,,0,0,0,,久經沙場後鍛鍊出強大的本領
Dialogue: 0,0:17:54.27,0:17:57.38,TW,,0,0,0,,對自己的工作也有深刻的理解
Dialogue: 0,0:17:57.71,0:18:02.38,TW,,0,0,0,,不過 也有像鷹岡這樣的反面教材
Dialogue: 0,0:18:02.63,0:18:04.67,TW,,0,0,0,,追趕自己欣賞的人
Dialogue: 0,0:18:05.03,0:18:07.03,TW,,0,0,0,,超越自己鄙視的人
Dialogue: 0,0:18:07.53,0:18:09.69,TW,,0,0,0,,也許 反復的追趕和超越
Dialogue: 0,0:18:10.11,0:18:11.48,TW,,0,0,0,,便是成長的過程吧
Dialogue: 0,0:18:15.78,0:18:17.05,TW,,0,0,0,,爆炸了喔
Dialogue: 0,0:18:17.15,0:18:18.10,TW,,0,0,0,,幹掉了嗎
Dialogue: 0,0:18:19.64,0:18:23.36,TW,,0,0,0,,問是這麼問 但大家心中也隱約有了答案
Dialogue: 0,0:18:26.06,0:18:29.57,TW,,0,0,0,,這次是為師無能 讓同學們受苦了
Dialogue: 0,0:18:29.76,0:18:33.44,TW,,0,0,0,,但是同學們 和敵人戰鬥 和病毒戰鬥
Dialogue: 0,0:18:33.60,0:18:35.60,TW,,0,0,0,,你們真的做得非常好
Dialogue: 0,0:18:35.92,0:18:38.26,TW,,0,0,0,,殺老師 早安
Dialogue: 0,0:18:38.75,0:18:41.19,TW,,0,0,0,,果然老師還是有觸手比較像樣
Dialogue: 0,0:18:39.72,0:18:40.59,TW,,0,0,0,,{\an1}笨蛋
Dialogue: 0,0:18:41.21,0:18:43.62,TW,,0,0,0,,是啊 早安
Dialogue: 0,0:18:43.79,0:18:46.66,TW,,0,0,0,,那麼我們繼續享受這次旅行吧
Dialogue: 0,0:18:46.74,0:18:47.41,TW,,0,0,0,,好
Dialogue: 0,0:18:47.60,0:18:50.50,TW,,0,0,0,,還怎麼享受 明天早上就要回去了吧
Dialogue: 0,0:18:50.50,0:18:51.96,TW,,0,0,0,,你在說什麼啦
Dialogue: 0,0:18:52.20,0:18:56.15,TW,,0,0,0,,為師基本處在完全防禦形態 根本就沒玩夠
Dialogue: 0,0:18:56.31,0:18:57.49,TW,,0,0,0,,你精神真好…
Dialogue: 0,0:18:57.82,0:18:59.89,TW,,0,0,0,,難得能和自己的學生住在一起
Dialogue: 0,0:18:59.89,0:19:01.70,TW,,0,0,0,,這樣的夏天可沒有第二次
Dialogue: 0,0:19:02.08,0:19:04.30,TW,,0,0,0,,一秒都不能浪費勒
Dialogue: 0,0:19:05.56,0:19:06.56,TW,,0,0,0,,你幹嘛啦
Dialogue: 0,0:19:06.74,0:19:09.35,TW,,0,0,0,,你不是說一秒都不能浪費嗎
Dialogue: 0,0:19:11.01,0:19:13.99,TW,,0,0,0,,不愧是業 趁對方放鬆警惕…
Dialogue: 0,0:19:16.24,0:19:18.71,TW,,0,0,0,,我還以為剛才能得手呢
Dialogue: 0,0:19:18.78,0:19:20.22,TW,,0,0,0,,渚你也要來一槍嗎
Dialogue: 0,0:19:21.12,0:19:24.03,TW,,0,0,0,,沒錯 要趁這個機會好好享受
Dialogue: 0,0:19:24.68,0:19:25.94,TW,,0,0,0,,完全同意
Dialogue: 0,0:19:25.94,0:19:27.11,TW,,0,0,0,,走吧
Dialogue: 0,0:19:27.15,0:19:28.34,TW,,0,0,0,,等等我啦
Dialogue: 0,0:19:29.47,0:19:31.49,TW,,0,0,0,,終於恢復精神 玩得起來了
Dialogue: 0,0:19:31.49,0:19:32.99,TW,,0,0,0,,大家都是穿著泳衣來的喔
Dialogue: 0,0:19:32.99,0:19:34.40,TW,,0,0,0,,我忘記穿了
Dialogue: 0,0:19:34.69,0:19:35.74,TW,,0,0,0,,看招
Dialogue: 0,0:19:36.51,0:19:37.70,TW,,0,0,0,,膽子不小嘛
Dialogue: 0,0:19:37.70,0:19:39.64,TW,,0,0,0,,讓我揉揉嘛
Dialogue: 0,0:19:40.51,0:19:43.68,TW,,0,0,0,,哇 也帶為師一起玩嘛
Dialogue: 0,0:19:43.82,0:19:44.56,TW,,0,0,0,,來啊
Dialogue: 0,0:19:48.22,0:19:50.87,TW,,0,0,0,,不行 這樣為師會被泡漲的
Dialogue: 0,0:19:51.30,0:19:52.56,TW,,0,0,0,,被發現了啊
Dialogue: 0,0:19:52.83,0:19:54.53,TW,,0,0,0,,對嘛 這樣才對嘛
Dialogue: 0,0:19:54.69,0:19:57.06,TW,,0,0,0,,夏天就是要有這種活動嘛
Dialogue: 0,0:19:57.12,0:20:00.03,TW,,0,0,0,,也帶我一起玩嘛
Dialogue: 0,0:20:00.03,0:20:01.43,TW,,0,0,0,,去死
Dialogue: 0,0:20:00.35,0:20:01.43,TW,,0,0,0,,{\an3}好短
Dialogue: 0,0:20:01.50,0:20:04.57,TW,,0,0,0,,同學們 我們之後還要放煙火喔
Dialogue: 0,0:20:04.62,0:20:07.45,TW,,0,0,0,,也要好好陪為師玩喔
Dialogue: 0,0:20:07.61,0:20:08.94,TW,,0,0,0,,那隻章魚
Dialogue: 0,0:20:09.05,0:20:12.89,TW,,0,0,0,,烏間長官 我們是否先撤退
Dialogue: 0,0:20:13.01,0:20:14.87,TW,,0,0,0,,好 你們撤吧
Dialogue: 0,0:20:14.87,0:20:16.28,TW,,0,0,0,,等等
Dialogue: 0,0:20:16.84,0:20:19.49,TW,,0,0,0,,你沒在灌混凝土喔
Dialogue: 0,0:20:19.74,0:20:22.38,TW,,0,0,0,,既然要下海玩 就叫上我嘛
Dialogue: 0,0:20:22.48,0:20:23.83,TW,,0,0,0,,這泳衣太羞恥了
Dialogue: 0,0:20:23.83,0:20:24.90,TW,,0,0,0,,太拼了
Dialogue: 0,0:20:24.90,0:20:26.22,TW,,0,0,0,,閉嘴 臭小鬼們
Dialogue: 0,0:20:26.39,0:20:29.47,TW,,0,0,0,,烏間 你現在有空嗎
Dialogue: 0,0:20:29.55,0:20:32.52,TW,,0,0,0,,別管這群小鬼頭了 我們去那邊的海灣…
Dialogue: 0,0:20:31.86,0:20:32.75,TW,,0,0,0,,{\an1}我沒興趣
Dialogue: 0,0:20:33.58,0:20:35.21,TW,,0,0,0,,果然是碧琪啊
Dialogue: 0,0:20:35.21,0:20:36.71,TW,,0,0,0,,你說什麼
Dialogue: 0,0:20:37.57,0:20:40.41,TW,,0,0,0,,你們最近越來越囂張了喔
Dialogue: 0,0:20:40.41,0:20:42.53,TW,,0,0,0,,臭小鬼們 別小看我
Dialogue: 0,0:20:42.64,0:20:43.48,TW,,0,0,0,,{\an1}給我站住
Dialogue: 0,0:20:43.77,0:20:45.34,TW,,0,0,0,,你這次做得很好
Dialogue: 0,0:20:53.90,0:20:56.37,TW,,0,0,0,,終點站E班是間暗殺教室
Dialogue: 0,0:20:57.54,0:20:58.93,TW,,0,0,0,,我們是殺手
Dialogue: 0,0:20:59.81,0:21:01.01,TW,,0,0,0,,目標是…
Dialogue: 0,0:21:01.63,0:21:02.58,TW,,0,0,0,,老師
Dialogue: 0,0:21:06.64,0:21:09.40,TW,,0,0,0,,同學們早安
Dialogue: 0,0:21:09.64,0:21:13.92,TW,,0,0,0,,在第二學期 也要努力學習 努力暗殺哦
Dialogue: 0,0:21:14.64,0:21:18.12,TW,,0,0,0,,殺老師和我們的暗殺教室
Dialogue: 0,0:21:19.39,0:21:22.21,TW,,0,0,0,,上課的鈴聲 今天也照常響起
