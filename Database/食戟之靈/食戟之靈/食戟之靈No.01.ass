Dialogue: 0,0:00:03.23,0:00:03.98,Default,FR,0,0,0,,超
Dialogue: 0,0:00:04.23,0:00:04.89,Default,FR,0,0,0,,難
Dialogue: 0,0:00:05.15,0:00:05.81,Default,FR,0,0,0,,吃
Dialogue: 0,0:00:06.06,0:00:07.65,Default,FR,0,0,0,,超難吃
Dialogue: 0,0:00:08.86,0:00:09.48,Default,,0,0,0,,難吃！
Dialogue: 0,0:00:10.83,0:00:14.26,Default,,0,0,0,,不搭味  已經到破壞性的程度了
Dialogue: 0,0:00:15.00,0:00:16.07,Default,,0,0,0,,不搭味…
Dialogue: 0,0:00:17.21,0:00:19.27,Default,,0,0,0,,魷魚鬚和花生醬
Dialogue: 0,0:00:20.15,0:00:23.32,Default,,0,0,0,,太搞笑了  難吃得讓人發笑
Dialogue: 0,0:00:26.08,0:00:26.68,Default,,0,0,0,,創真
Dialogue: 0,0:00:27.90,0:00:29.02,Default,,0,0,0,,你朋友來了
Dialogue: 0,0:00:29.44,0:00:29.97,Default,,0,0,0,,來啦
Dialogue: 0,0:00:32.54,0:00:33.88,Default,,0,0,0,,那就開工吧
Dialogue: 0,0:00:49.55,0:00:50.48,Default,,0,0,0,,敬請品嘗
Dialogue: 0,0:00:51.42,0:00:52.48,8para,,0,0,0,,聞起來好香
Dialogue: 0,0:00:52.05,0:00:52.76,Default,,0,0,0,,請用
Dialogue: 0,0:00:54.01,0:00:54.86,Default,,0,0,0,,我開動了
Dialogue: 0,0:00:56.13,0:00:58.02,Default,,0,0,0,,料理比賽在進行呢
Dialogue: 0,0:00:59.00,0:01:01.02,Default,,0,0,0,,今天的評委是倉瀨啊
Dialogue: 0,0:01:14.60,0:01:15.65,Default,,0,0,0,,難道說…
Dialogue: 0,0:01:15.91,0:01:16.88,Default,,0,0,0,,今天終於…
Dialogue: 0,0:01:16.92,0:01:19.02,Default,,0,0,0,,小聲點  真由正在思考呢
Dialogue: 0,0:01:23.44,0:01:24.06,Default,,0,0,0,,這邊！
Dialogue: 0,0:01:26.31,0:01:27.34,Default,,0,0,0,,結果出來啦
Dialogue: 0,0:01:27.69,0:01:29.70,Default,,0,0,0,,今天依舊是老爹的勝利！
Dialogue: 0,0:01:32.11,0:01:35.07,0wrt,FR,0,0,0,,{\fad(460,0)\fn方正黑體_GBK\1c313131\fscx82\fs26\pos(332.4,367)}初中3年級
Dialogue: 0,0:01:35.11,0:01:38.03,0wrt,FR,0,0,0,,{\fad(460,0)\fn方正黑體_GBK\1c313131\fscx82\pos(988,415)\fs26}幸平餐館店主
Dialogue: 0,0:01:34.48,0:01:37.87,Default,,0,0,0,,創真  你的修行還差得遠嘛
Dialogue: 0,0:01:38.74,0:01:41.38,Default,,0,0,0,,看起來今天是我輸了
Dialogue: 0,0:01:41.66,0:01:43.79,Default,,0,0,0,,等你贏過一次再這麼說
Dialogue: 0,0:01:44.34,0:01:46.94,Default,,0,0,0,,你輸了差不多該有500次了吧？
Dialogue: 0,0:01:47.13,0:01:50.93,Default,,0,0,0,,啥？別得意了  這才第489次呢
Dialogue: 0,0:01:51.24,0:01:53.12,Default,,0,0,0,,這不馬上就到了嗎
Dialogue: 0,0:01:53.17,0:01:54.20,Default,,0,0,0,,煩死啦  老爹
Dialogue: 0,0:02:00.24,0:02:02.68,Default,,0,0,0,,老爹的炒飯好吃真不是蓋的！
Dialogue: 0,0:02:02.93,0:02:06.80,Default,,0,0,0,,能在家邊吃到這等味道  好幸福啊！
Dialogue: 0,0:02:06.91,0:02:08.36,Default,,0,0,0,,受不了啦！
Dialogue: 0,0:02:08.66,0:02:11.97,Default,,0,0,0,,但…但是  幸平的炒飯也很好吃的
Dialogue: 0,0:02:12.41,0:02:14.94,Default,,0,0,0,,我從來沒吃過這麼美味的炒飯
Dialogue: 0,0:02:15.92,0:02:16.78,Default,,0,0,0,,謝謝…
Dialogue: 0,0:02:18.50,0:02:21.32,Default,,0,0,0,,我這邊有份剛出爐的新作
Dialogue: 0,0:02:22.46,0:02:23.89,Default,,0,0,0,,可以的話  嘗一點如何？
Dialogue: 0,0:02:24.23,0:02:26.49,Default,,0,0,0,,可以嗎？好想嘗嘗看
Dialogue: 0,0:02:26.76,0:02:29.38,Default,,0,0,0,,烤魷魚鬚拌花生醬
Dialogue: 0,0:02:29.67,0:02:30.14,Default,,0,0,0,,啥？
Dialogue: 0,0:02:30.29,0:02:31.05,Default,,0,0,0,,真由
Dialogue: 0,0:02:31.77,0:02:32.77,Default,,0,0,0,,這次又來{MUST SPLT}
Dialogue: 0,0:02:32.83,0:02:34.34,Default,,0,0,0,,好像比以往的還勁爆
Dialogue: 0,0:02:34.66,0:02:36.29,Default,,0,0,0,,來吧  不用客氣
Dialogue: 0,0:02:36.67,0:02:38.65,Default,,0,0,0,,可是難吃得叫人發笑哦
Dialogue: 0,0:02:38.96,0:02:40.68,Default,,0,0,0,,不…不要…
Dialogue: 0,0:02:47.92,0:02:50.08,Default,,0,0,0,,討厭
Dialogue: 0,0:02:53.22,0:02:56.26,Default,,0,0,0,,「魷魚鬚的味道變得異常奇怪」
Dialogue: 0,0:02:57.00,0:02:59.86,Default,,0,0,0,,「難吃得好似渾身上下被肆意玩弄」
Dialogue: 0,0:03:00.68,0:03:03.64,Default,,0,0,0,,這位女生事後這麼回憶到
Dialogue: 0,0:03:06.04,0:03:09.25,Default,,0,0,0,,所謂料理  其本身即是一望無際的荒野
Dialogue: 0,0:03:10.31,0:03:12.20,Default,,0,0,0,,是既有著無數令人垂涎欲滴
Dialogue: 0,0:03:12.65,0:03:15.40,Default,,0,0,0,,又存在難以下嚥料理的荒野
Dialogue: 0,0:03:16.28,0:03:20.54,Default,,0,0,0,,我想走到地平線的那一端去看看啊
Dialogue: 0,0:03:20.69,0:03:22.98,Default,,0,0,0,,笨蛋吵死了  你一個人去吧
Dialogue: 0,0:03:23.41,0:03:25.42,Default,,0,0,0,,真由振作點啊  沒事吧？
Dialogue: 0,0:03:26.45,0:03:29.10,Default,,0,0,0,,魷魚它…魷魚它…
Dialogue: 0,0:03:29.81,0:03:33.00,Default,,0,0,0,,幸平他就連失敗作也會開心地叫人去吃啊
Dialogue: 0,0:03:33.26,0:03:36.24,Default,,0,0,0,,要是沒這怪癖  確實是個稱職的廚師了呢
Dialogue: 0,0:03:37.35,0:03:38.71,Default,,0,0,0,,比起你這個
Dialogue: 0,0:03:39.01,0:03:42.72,Default,,0,0,0,,我做的「草莓醬拌魚乾」要更恐怖啊  創真
Dialogue: 0,0:03:42.92,0:03:44.25,Default,,0,0,0,,啊  那個啊
Dialogue: 0,0:03:44.94,0:03:47.73,Default,,0,0,0,,真的是難吃到極點了
Dialogue: 0,0:03:47.96,0:03:48.65,Default,,0,0,0,,是吧？
Dialogue: 0,0:03:49.09,0:03:51.19,Default,,0,0,0,,但還是比不上花生魷魚
Dialogue: 0,0:03:51.59,0:03:53.82,Default,,0,0,0,,不對  魚乾草莓醬更難吃
Dialogue: 0,0:03:53.89,0:03:55.12,Default,,0,0,0,,花生魷魚更難吃
Dialogue: 0,0:03:56.02,0:03:58.27,Default,,0,0,0,,真是有其父必有其子
Dialogue: 0,0:03:58.31,0:03:59.76,Default,,0,0,0,,我做的更難吃！
Dialogue: 0,0:05:37.48,0:05:41.90,0wrt,FR,0,0,0,,{\fad(580,420)\1c080000\3cC0C0C0\blur1\bord1\b1\move(95,440,95,472)}無\N垠\N的\N荒\N野
Dialogue: 0,0:05:37.02,0:05:38.06,8para,,0,0,0,,給我來份每日套餐
Dialogue: 0,0:05:39.75,0:05:40.50,8para,,0,0,0,,啊  來了來了
Dialogue: 0,0:05:42.67,0:05:43.90,Default,,0,0,0,,韭菜豬肝套餐  讓您久等了
Dialogue: 0,0:05:45.01,0:05:46.74,Default,,0,0,0,,我要一份肉豆腐套餐吧
Dialogue: 0,0:05:47.30,0:05:48.78,Default,,0,0,0,,我來個每日套餐
Dialogue: 0,0:05:49.37,0:05:51.63,Default,,0,0,0,,明白  一份肉豆腐套餐
Dialogue: 0,0:05:51.88,0:05:52.64,Default,,0,0,0,,每日一份
Dialogue: 0,0:05:53.20,0:05:53.96,Default,,0,0,0,,瞭解
Dialogue: 0,0:05:54.59,0:05:55.72,Default,,0,0,0,,飽啦
Dialogue: 0,0:05:55.77,0:05:56.74,Default,,0,0,0,,真好吃啊
Dialogue: 0,0:05:56.80,0:05:57.57,Default,,0,0,0,,多謝招待
Dialogue: 0,0:05:57.62,0:05:58.28,Default,,0,0,0,,感謝惠顧
Dialogue: 0,0:05:58.42,0:05:59.04,Default,,0,0,0,,感謝惠顧
Dialogue: 0,0:06:05.58,0:06:08.92,Default,,0,0,0,,創真  那邊收拾完了就去把炭爐的火滅了
Dialogue: 0,0:06:12.36,0:06:16.17,Default,,0,0,0,,今天的炒飯  應該再多顛三次勺的
Dialogue: 0,0:06:17.80,0:06:19.41,Default,,0,0,0,,馬上就要初中畢業了
Dialogue: 0,0:06:20.04,0:06:22.19,Default,,0,0,0,,之後就能進行更多的料理修行了
Dialogue: 0,0:06:24.03,0:06:26.54,Default,,0,0,0,,要儘早超越老爹
Dialogue: 0,0:06:27.28,0:06:29.62,Default,,0,0,0,,然後成為能夠背負起這家店的廚師
Dialogue: 0,0:06:33.40,0:06:34.61,Default,,0,0,0,,啊  歡迎光…
Dialogue: 0,0:06:36.18,0:06:37.90,Default,,0,0,0,,不好意思
Dialogue: 0,0:06:39.00,0:06:40.88,Default,,0,0,0,,看起來好像還在營業中
Dialogue: 0,0:06:41.44,0:06:44.09,Default,,0,0,0,,前來打擾萬分抱歉
Dialogue: 0,0:06:45.93,0:06:49.24,Default,,0,0,0,,我是「URBANLIFE」的峰崎
Dialogue: 0,0:06:50.77,0:06:51.66,Default,,0,0,0,,您要來點什麼？
Dialogue: 0,0:06:52.00,0:06:52.47,Default,,0,0,0,,什麼？
Dialogue: 0,0:06:52.66,0:06:55.44,Default,,0,0,0,,今天的推薦菜單是金眼鯛刺身和…
Dialogue: 0,0:06:55.54,0:06:57.38,Default,,0,0,0,,不不  今天所來
Dialogue: 0,0:06:57.91,0:07:02.66,Default,,0,0,0,,是為再次說明前日談過的計畫
Dialogue: 0,0:07:03.60,0:07:09.82,Default,,0,0,0,,為了在這座城市裡以建造花園式高級住宅為理念的都市公寓
Dialogue: 0,0:07:10.11,0:07:14.80,Default,,0,0,0,,說白了就是你們這群開發商想叫我們滾蛋吧？
Dialogue: 0,0:07:15.12,0:07:16.13,Default,,0,0,0,,之前已經聽過了
Dialogue: 0,0:07:16.80,0:07:17.37,Default,,0,0,0,,請回吧
Dialogue: 0,0:07:17.76,0:07:19.88,Default,,0,0,0,,我們完全沒有閉店的打算
Dialogue: 0,0:07:21.70,0:07:25.18,Default,,0,0,0,,那我將名片留下
Dialogue: 0,0:07:25.66,0:07:27.45,Default,,0,0,0,,隨時都可聯絡我
Dialogue: 0,0:07:28.44,0:07:30.77,Default,,0,0,0,,說回來店主喲  現在這個世道
Dialogue: 0,0:07:31.05,0:07:34.06,Default,,0,0,0,,經營小店也是越來越難了吧
Dialogue: 0,0:07:34.84,0:07:38.16,Default,,0,0,0,,聽聞很多店連進貨都頭疼不已
Dialogue: 0,0:07:39.02,0:07:40.75,Default,,0,0,0,,我這完全沒有這問題
Dialogue: 0,0:07:41.14,0:07:42.37,Default,,0,0,0,,是這樣嗎？
Dialogue: 0,0:07:42.73,0:07:47.28,Default,,0,0,0,,「幸平」會負責提供客人們想吃的食物
Dialogue: 0,0:07:47.60,0:07:51.19,Default,,0,0,0,,真是出色  真是服務業的楷模
Dialogue: 0,0:07:52.95,0:07:56.14,Default,,0,0,0,,但是  如果你們沒能供上客人想要的食物
Dialogue: 0,0:07:56.97,0:07:59.33,Default,,0,0,0,,你們要怎麼負責？
Dialogue: 0,0:08:01.42,0:08:04.60,Default,,0,0,0,,那時候我就打掃乾淨店鋪
Dialogue: 0,0:08:04.90,0:08:06.72,Default,,0,0,0,,關門還是其他什麼都悉聽尊便
Dialogue: 0,0:08:13.16,0:08:14.41,Default,,0,0,0,,君子一言駟馬難追哦？
Dialogue: 0,0:08:14.85,0:08:15.41,Default,,0,0,0,,那是當然
Dialogue: 0,0:08:17.58,0:08:19.09,Default,,0,0,0,,那麼  我們還會再來的
Dialogue: 0,0:08:24.94,0:08:27.08,Default,,0,0,0,,老爹  鹽！快撒鹽！
Dialogue: 0,0:08:27.25,0:08:28.76,Default,,0,0,0,,太浪費了駁回
Dialogue: 0,0:08:33.05,0:08:34.33,Default,,0,0,0,,待會做點什麼？
Dialogue: 0,0:08:34.81,0:08:35.46,Default,,0,0,0,,去卡拉OK嗎？
Dialogue: 0,0:08:35.71,0:08:37.44,Default,,0,0,0,,那去唱什麼？
Dialogue: 0,0:08:37.84,0:08:38.46,Default,,0,0,0,,動畫歌曲吧
Dialogue: 0,0:08:38.54,0:08:40.04,8para,,0,0,0,,你每次都…
Dialogue: 0,0:08:40.08,0:08:41.86,8para,,0,0,0,,別小看動畫歌曲啊
Dialogue: 0,0:08:39.26,0:08:39.96,Default,,0,0,0,,真由？
Dialogue: 0,0:08:53.74,0:08:54.91,Default,,0,0,0,,老爹？
Dialogue: 0,0:08:55.49,0:08:56.85,Default,,0,0,0,,已經回家了嗎
Dialogue: 0,0:08:57.18,0:09:00.01,Default,,0,0,0,,剛去買早飯材料了  怎麼了？
Dialogue: 0,0:09:00.96,0:09:02.58,Default,,0,0,0,,我今天有事出下門
Dialogue: 0,0:09:03.21,0:09:05.30,Default,,0,0,0,,是嗎  真少見啊
Dialogue: 0,0:09:05.83,0:09:07.16,Default,,0,0,0,,明天才會回來
Dialogue: 0,0:09:07.55,0:09:08.71,Default,,0,0,0,,不用開店也行的
Dialogue: 0,0:09:09.39,0:09:09.93,Default,,0,0,0,,知道了
Dialogue: 0,0:09:11.65,0:09:12.23,Default,,0,0,0,,我說你啊…
Dialogue: 0,0:09:13.66,0:09:15.33,Default,,0,0,0,,初中畢業之後打算幹什麼？
Dialogue: 0,0:09:17.92,0:09:18.89,Default,,0,0,0,,還用問嗎？
Dialogue: 0,0:09:19.34,0:09:20.72,Default,,0,0,0,,在店裡磨練廚藝…
Dialogue: 0,0:09:21.51,0:09:22.02,Default,,0,0,0,,是嗎
Dialogue: 0,0:09:24.70,0:09:25.85,Default,,0,0,0,,怎麼回事啊？
Dialogue: 0,0:09:27.24,0:09:32.05,Default,,0,0,0,,說起來能讓老爹休店的事情…
Dialogue: 0,0:09:34.47,0:09:36.65,Default,,0,0,0,,老爹不怎麼談自己的事
Dialogue: 0,0:09:37.97,0:09:39.21,Default,,0,0,0,,回頭想一想
Dialogue: 0,0:09:39.67,0:09:41.46,Default,,0,0,0,,我對於作為廚師的老爹
Dialogue: 0,0:09:42.35,0:09:45.09,Default,,0,0,0,,可能毫不瞭解
Dialogue: 0,0:09:53.95,0:09:56.36,Default,,0,0,0,,肉…全都不能用了!?
Dialogue: 0,0:09:57.65,0:09:59.50,Default,,0,0,0,,冰箱裡全都被…
Dialogue: 0,0:10:00.31,0:10:00.98,Default,,0,0,0,,是小偷？
Dialogue: 0,0:10:01.49,0:10:03.25,Default,,0,0,0,,不可能  怎麼會有這樣的小偷
Dialogue: 0,0:10:14.97,0:10:16.21,Default,,0,0,0,,奇怪
Dialogue: 0,0:10:16.99,0:10:20.21,Default,,0,0,0,,這裡看上去比昨天要整潔不少呢
Dialogue: 0,0:10:20.76,0:10:23.42,Default,,0,0,0,,是不是因為礙眼的招牌看不見了呢？
Dialogue: 0,0:10:26.34,0:10:28.84,Default,,0,0,0,,現在好想吃肉啊
Dialogue: 0,0:10:29.47,0:10:34.80,Default,,0,0,0,,我在六本木經常吃的霜降牛排最棒了呢
Dialogue: 0,0:10:36.26,0:10:40.10,Default,,0,0,0,,醇厚的肉汁在口中蔓延開來
Dialogue: 0,0:10:42.49,0:10:45.49,Default,,0,0,0,,我說啊  你能不能給我做一份
Dialogue: 0,0:10:46.07,0:10:49.37,Default,,0,0,0,,美味多汁的肉類料理
Dialogue: 0,0:10:50.99,0:10:53.48,Default,,0,0,0,,咦？難道做不出來嗎？
Dialogue: 0,0:10:54.07,0:10:56.40,Default,,0,0,0,,客人可是想吃肉哦？
Dialogue: 0,0:10:57.52,0:10:58.89,Default,,0,0,0,,拿不出來嗎？
Dialogue: 0,0:10:59.31,0:11:02.44,Default,,0,0,0,,你昨天可說過的吧
Dialogue: 0,0:11:03.38,0:11:06.38,Default,,0,0,0,,端不上菜就關門大吉
Dialogue: 0,0:11:07.18,0:11:10.45,Default,,0,0,0,,招牌現在也清乾淨了 不是正好嗎
Dialogue: 0,0:11:11.46,0:11:14.14,Default,,0,0,0,,這個店就乾脆關掉吧
Dialogue: 0,0:11:19.82,0:11:22.09,Default,,0,0,0,,多汁的肉類料理…
Dialogue: 0,0:11:24.04,0:11:25.36,Default,,0,0,0,,就點這麼多對吧？
Dialogue: 0,0:11:29.00,0:11:31.33,Default,,0,0,0,,如果我能端上來滿足你舌頭的料理
Dialogue: 0,0:11:32.60,0:11:35.37,Default,,0,0,0,,就給我發誓再也不會踏入這家店半步
Dialogue: 0,0:11:46.60,0:11:47.44,Default,,0,0,0,,一決勝負
Dialogue: 0,0:12:29.06,0:12:29.80,Default,,0,0,0,,我說你{MUST SPLT}
Dialogue: 0,0:12:30.47,0:12:32.27,Default,,0,0,0,,應該有把冰箱裡的東西全部都…{MUST SPLT}
Dialogue: 0,0:12:32.46,0:12:35.74,Default,,0,0,0,,是的  肉類  全部被我們剁碎了的
Dialogue: 0,0:12:36.70,0:12:39.05,Default,,0,0,0,,我點的可是多汁肉類料理啊？
Dialogue: 0,0:12:39.88,0:12:42.58,Default,,0,0,0,,他連像樣的食材都沒有  到底要怎麼做？
Dialogue: 0,0:13:09.68,0:13:10.30,Default,,0,0,0,,為什麼？
Dialogue: 0,0:13:10.51,0:13:11.29,Default,,0,0,0,,怎麼回事？
Dialogue: 0,0:13:11.47,0:13:12.78,Default,,0,0,0,,這麼豐盛的…
Dialogue: 0,0:13:13.70,0:13:14.86,Default,,0,0,0,,脆皮烤肉！
Dialogue: 0,0:13:16.07,0:13:17.13,Default,,0,0,0,,我來回答你  這是將土豆
Dialogue: 0,0:13:17.88,0:13:22.41,Default,,0,0,0,,用明天早飯時吃的厚切培根卷起來的
Dialogue: 0,0:13:23.28,0:13:25.00,Default,,0,0,0,,「冒牌脆皮烤肉」
Dialogue: 0,0:13:25.55,0:13:26.09,Default,,0,0,0,,什！
Dialogue: 0,0:13:26.47,0:13:27.26,Default,,0,0,0,,土豆？
Dialogue: 0,0:13:27.79,0:13:28.64,Default,,0,0,0,,冒牌？
Dialogue: 0,0:13:29.12,0:13:30.01,Default,,0,0,0,,烤？
Dialogue: 0,0:13:30.36,0:13:33.54,Default,,0,0,0,,沒錯  先把土豆蒸熟
Dialogue: 0,0:13:34.81,0:13:37.36,Default,,0,0,0,,怎麼回事？這個氛圍
Dialogue: 0,0:13:38.18,0:13:39.52,Default,,0,0,0,,你在耍我嗎
Dialogue: 0,0:13:40.85,0:13:42.45,Default,,0,0,0,,我說過我要吃肉類料理！
Dialogue: 0,0:13:43.07,0:13:45.16,Default,,0,0,0,,已經沒有周旋的餘地了
Dialogue: 0,0:13:45.84,0:13:47.35,Default,,0,0,0,,快點把這個店交出來
Dialogue: 0,0:13:47.95,0:13:48.55,Default,,0,0,0,,聽好了？
Dialogue: 0,0:13:48.87,0:13:50.67,Default,,0,0,0,,真正成功的廚師
Dialogue: 0,0:13:51.15,0:13:54.40,Default,,0,0,0,,都在我去過的那些高級飯店
Dialogue: 0,0:13:54.47,0:13:56.18,Default,,0,0,0,,或者一流酒店裡
Dialogue: 0,0:13:57.18,0:13:58.16,Default,,0,0,0,,失敗作！
Dialogue: 0,0:13:58.94,0:13:59.91,Default,,0,0,0,,要我看來
Dialogue: 0,0:14:00.29,0:14:02.42,Default,,0,0,0,,這家店根本沒有存在的價值了
Dialogue: 0,0:14:04.62,0:14:06.72,Default,,0,0,0,,「幸平」到底有沒有存在的價值
Dialogue: 0,0:14:07.54,0:14:08.99,Default,,0,0,0,,從這盤菜中就能明白
Dialogue: 0,0:14:16.28,0:14:17.22,Default,,0,0,0,,敬請品嘗
Dialogue: 0,0:14:57.43,0:14:58.73,Default,,0,0,0,,每次咀嚼
Dialogue: 0,0:14:59.29,0:15:02.66,Default,,0,0,0,,充分燒烤過的培根的醇香肉汁
Dialogue: 0,0:15:05.35,0:15:07.59,Default,,0,0,0,,就會在嘴裡整個蔓延
Dialogue: 0,0:15:18.03,0:15:20.28,Default,,0,0,0,,好像覺得很好吃嘛
Dialogue: 0,0:15:21.30,0:15:23.66,Default,,0,0,0,,這可是你瞧不起的店做出的料理喲？
Dialogue: 0,0:15:25.83,0:15:26.87,Default,,0,0,0,,讓我來告訴你吧
Dialogue: 0,0:15:27.58,0:15:28.99,Default,,0,0,0,,這份味道的秘密
Dialogue: 0,0:15:32.95,0:15:35.14,Default,,0,0,0,,在蒸熟的土豆中
Dialogue: 0,0:15:35.69,0:15:38.11,Default,,0,0,0,,放入擁有容易吸收油脂的纖維質的蘑菇
Dialogue: 0,0:15:39.36,0:15:42.40,Default,,0,0,0,,並且為了增加甜味  跟洋蔥一起切碎放入
Dialogue: 0,0:15:44.09,0:15:46.65,Default,,0,0,0,,然後用厚培根緊緊纏住
Dialogue: 0,0:15:49.25,0:15:51.15,Default,,0,0,0,,放進烤箱烤熟
Dialogue: 0,0:15:52.07,0:15:54.53,Default,,0,0,0,,這樣一來  培根的外側開始變得焦脆
Dialogue: 0,0:15:55.96,0:15:59.64,Default,,0,0,0,,土豆蘑菇也會將豬肉的香味和油脂全部吸收
Dialogue: 0,0:16:04.50,0:16:05.18,Default,,0,0,0,,然後…
Dialogue: 0,0:16:07.87,0:16:13.00,Default,,0,0,0,,外表焦脆無比  裡面鮮嫩多汁  激發出富於刺激的味覺
Dialogue: 0,0:16:17.71,0:16:20.82,Default,,0,0,0,,以前給客人做土豆沙拉的時候
Dialogue: 0,0:16:22.04,0:16:23.25,Default,,0,0,0,,裝盤不小心裝錯了
Dialogue: 0,0:16:23.62,0:16:26.24,Default,,0,0,0,,將土豆不小心滲進了別的料理的肉汁
Dialogue: 0,0:16:28.87,0:16:31.05,Default,,0,0,0,,從那裡獲得了這道菜的靈感
Dialogue: 0,0:16:32.08,0:16:33.50,Default,,0,0,0,,從失敗作中呢
Dialogue: 0,0:16:35.01,0:16:36.60,Default,,0,0,0,,所…所以那又怎麼樣？
Dialogue: 0,0:16:37.26,0:16:38.04,Default,,0,0,0,,這種東西
Dialogue: 0,0:16:38.76,0:16:40.38,Default,,0,0,0,,根本不能稱作是肉類料理
Dialogue: 0,0:16:42.48,0:16:44.63,Default,,0,0,0,,但是…手根本…
Dialogue: 0,0:16:46.28,0:16:47.04,Default,,0,0,0,,停不下來！
Dialogue: 0,0:16:51.96,0:16:55.80,Default,,0,0,0,,還想  再多嘗一口肉汁的味道
Dialogue: 0,0:16:58.15,0:16:59.31,Default,,0,0,0,,你…你幹什麼
Dialogue: 0,0:17:00.18,0:17:02.11,Default,,0,0,0,,想繼續吃的話就發誓
Dialogue: 0,0:17:03.15,0:17:05.43,Default,,0,0,0,,再也不會找這家店麻煩
Dialogue: 0,0:17:06.90,0:17:07.87,Default,,0,0,0,,誰會發那種誓
Dialogue: 0,0:17:08.34,0:17:09.84,Default,,0,0,0,,是嘛
Dialogue: 0,0:17:10.52,0:17:13.47,Default,,0,0,0,,雖然很浪費  但也無奈
Dialogue: 0,0:17:15.86,0:17:18.19,Default,,0,0,0,,這道料理只能…
Dialogue: 0,0:17:18.23,0:17:19.44,Default,,0,0,0,,等…等一下
Dialogue: 0,0:17:20.38,0:17:20.89,Default,,0,0,0,,我發誓
Dialogue: 0,0:17:21.22,0:17:22.24,Default,,0,0,0,,我發誓就是了
Dialogue: 0,0:17:25.45,0:17:26.18,Default,,0,0,0,,啊？
Dialogue: 0,0:17:31.22,0:17:33.98,Default,,0,0,0,,還想要…那個…
Dialogue: 0,0:17:35.37,0:17:38.20,Default,,0,0,0,,請  給  我  吧
Dialogue: 0,0:18:23.82,0:18:29.75,Default,,0,0,0,,肉~  汁~
Dialogue: 0,0:18:43.78,0:18:44.58,Default,,0,0,0,,招待不周！
Dialogue: 0,0:19:08.55,0:19:09.63,Default,,0,0,0,,不管遇到什麼麻煩
Dialogue: 0,0:19:09.78,0:19:11.35,Default,,0,0,0,,我都不會讓這家店倒閉的
Dialogue: 0,0:19:12.96,0:19:16.89,Default,,0,0,0,,「幸平」是我將料理練到究極的城堡啊
Dialogue: 0,0:19:24.99,0:19:25.63,Default,,0,0,0,,老爹
Dialogue: 0,0:19:26.57,0:19:28.00,Default,,0,0,0,,好像發生了什麼啊
Dialogue: 0,0:19:28.82,0:19:30.26,Default,,0,0,0,,沒什麼大不了的啦
Dialogue: 0,0:19:31.03,0:19:33.51,Default,,0,0,0,,來了些沒禮貌的客人而已
Dialogue: 0,0:19:40.03,0:19:40.57,Default,,0,0,0,,創真
Dialogue: 0,0:19:43.35,0:19:44.85,Default,,0,0,0,,這家店  準備兩三年…
Dialogue: 0,0:19:46.75,0:19:47.43,Default,,0,0,0,,休業
Dialogue: 0,0:19:52.01,0:19:55.36,Default,,0,0,0,,嘛果然還是要去和常客們道個歉才行
Dialogue: 0,0:19:55.40,0:19:56.96,Default,,0,0,0,,先向兒子道歉啊
Dialogue: 0,0:19:57.87,0:20:01.75,Default,,0,0,0,,被以前的夥伴邀請說要不要一起工作
Dialogue: 0,0:20:02.15,0:20:02.63,Default,,0,0,0,,什麼
Dialogue: 0,0:20:03.58,0:20:05.68,Default,,0,0,0,,暫時會住在那邊
Dialogue: 0,0:20:06.07,0:20:07.44,Default,,0,0,0,,這邊就暫時就不回來了
Dialogue: 0,0:20:08.94,0:20:11.18,Default,,0,0,0,,怎麼能…擅自
Dialogue: 0,0:20:14.00,0:20:15.30,Default,,0,0,0,,喂  老爹
Dialogue: 0,0:20:15.77,0:20:17.35,Default,,0,0,0,,我去收拾下行李
Dialogue: 0,0:20:17.54,0:20:18.50,Default,,0,0,0,,馬上就走
Dialogue: 0,0:20:18.93,0:20:19.43,Default,,0,0,0,,等一下
Dialogue: 0,0:20:20.46,0:20:23.01,Default,,0,0,0,,你的生活費我會適當地打給你的
Dialogue: 0,0:20:23.23,0:20:24.00,Default,,0,0,0,,我說等一下
Dialogue: 0,0:20:25.04,0:20:28.92,Default,,0,0,0,,我一直…在這家店
Dialogue: 0,0:20:36.76,0:20:38.79,Default,,0,0,0,,是啟程的時候了  創真
Dialogue: 0,0:20:40.12,0:20:41.97,Default,,0,0,0,,去試試看你有多大本事吧
Dialogue: 0,0:20:46.59,0:20:47.72,Default,,0,0,0,,料理學校？
Dialogue: 0,0:20:48.62,0:20:51.34,Default,,0,0,0,,為什麼  這種時候還得去這種地方啊
Dialogue: 0,0:20:51.97,0:20:52.80,Default,,0,0,0,,不是正好嗎
Dialogue: 0,0:20:53.44,0:20:54.30,Default,,0,0,0,,反正店也要關門
Dialogue: 0,0:20:54.78,0:20:57.55,Default,,0,0,0,,這所學校也能拿到高中課程的學分
Dialogue: 0,0:20:58.48,0:21:00.86,Default,,0,0,0,,這三年  好好努力吧
Dialogue: 0,0:21:07.48,0:21:10.07,Default,,0,0,0,,付錢來學習料理  真是夠蠢的
Dialogue: 0,0:21:10.68,0:21:13.22,Default,,0,0,0,,反正料理學校都那樣吧
Dialogue: 0,0:21:14.34,0:21:15.36,Default,,0,0,0,,好的
Dialogue: 0,0:21:15.64,0:21:19.82,Default,,0,0,0,,今天來教大家做一道簡單的料理
Dialogue: 0,0:21:20.15,0:21:21.61,Default,,0,0,0,,好的  老師
Dialogue: 0,0:21:25.35,0:21:27.76,Default,,0,0,0,,進級考試落榜了
Dialogue: 0,0:21:27.86,0:21:28.59,Default,,0,0,0,,已經不行了…
Dialogue: 0,0:21:29.06,0:21:30.34,Default,,0,0,0,,人生已經結束了
Dialogue: 0,0:21:30.74,0:21:32.16,Default,,0,0,0,,拜託了
Dialogue: 0,0:21:33.23,0:21:35.76,Default,,0,0,0,,就算是一千萬兩千萬我都會給的
Dialogue: 0,0:21:36.15,0:21:39.28,Default,,0,0,0,,請撤回我兒子的退學吧！
Dialogue: 0,0:21:39.33,0:21:40.07,Default,,0,0,0,,怎麼回事？
Dialogue: 0,0:21:46.66,0:21:48.43,Default,,0,0,0,,什麼  我沒跟你說嗎
Dialogue: 0,0:21:51.31,0:21:53.39,Default,,0,0,0,,那是日本屈指可數的料理學校
Dialogue: 0,0:21:54.25,0:21:56.79,Default,,0,0,0,,畢業率低至百分之十以下
Dialogue: 0,0:21:57.60,0:21:59.39,Default,,0,0,0,,超精英學校
Dialogue: 0,0:24:04.71,0:24:05.42,Default,FR,0,0,0,,超
Dialogue: 0,0:24:05.67,0:24:06.38,Default,FR,0,0,0,,難
Dialogue: 0,0:24:06.63,0:24:07.34,Default,FR,0,0,0,,吃
Dialogue: 0,0:24:07.55,0:24:09.30,Default,FR,0,0,0,,超難吃
Dialogue: 0,0:24:09.77,0:24:10.56,Default,,0,0,0,,難吃！
Dialogue: 0,0:24:14.33,0:24:15.63,Default,,0,0,0,,真是要命的高湯
Dialogue: 0,0:24:16.23,0:24:18.24,Default,,0,0,0,,就好像平靜地在瀑布下修煉時
Dialogue: 0,0:24:18.28,0:24:20.50,Default,,0,0,0,,點唱機從天而降的味道
Dialogue: 0,0:24:20.83,0:24:22.06,Default,,0,0,0,,點唱機？
Dialogue: 0,0:24:22.33,0:24:23.36,Default,,0,0,0,,好難理解…
Dialogue: 0,0:24:24.91,0:24:28.11,Default,,0,0,0,,真…真的很對不起  繪裡奈大小姐
Dialogue: 0,0:24:28.51,0:24:31.24,Default,,0,0,0,,真的是…不好笑
Dialogue: 0,0:24:32.60,0:24:34.22,Default,,0,0,0,,一點也不好笑
Dialogue: 0,0:24:41.80,0:24:44.40,Default,,0,0,0,,下集「食戟之靈」
Dialogue: 0,0:24:45.07,0:24:46.14,Default,,0,0,0,,第2道菜
