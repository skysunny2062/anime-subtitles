Dialogue: 0,0:02:54.65,0:02:59.62,0wrt,epsd,0,0,0,,{\fad(1000,1000)\1c080000\3cFFFFFF\blur1\bord1.2\b1\move(1185,368,1185,384)}冰\N之\N女\N王\N和\N春\N天\N的\N暴\N風\N雨
Dialogue: 0,0:00:10.96,0:00:11.98,Default,U,0,0,0,,太美味了！
Dialogue: 0,0:00:13.67,0:00:15.82,Default,U,0,0,0,,充分活用了春季的食材
Dialogue: 0,0:00:16.81,0:00:18.00,Default,U,0,0,0,,這麼精緻的料理
Dialogue: 0,0:00:18.38,0:00:20.25,Default,U,0,0,0,,竟然能在那麼短的時間做出來？
Dialogue: 0,0:00:22.04,0:00:24.26,Default,U,0,0,0,,和其他的學生根本不是一個水準
Dialogue: 0,0:00:25.52,0:00:27.96,Default,U,0,0,0,,再次自我介紹一下
Dialogue: 0,0:00:30.87,0:00:32.14,Default,U,0,0,0,,遠月十傑…
Dialogue: 0,0:00:34.59,0:00:35.59,Default,U,0,0,0,,第七席
Dialogue: 0,0:00:37.08,0:00:38.41,Default,U,0,0,0,,一色慧
Dialogue: 0,0:00:43.61,0:00:46.85,Default,,0,0,0,,你竟然是…十傑？
Dialogue: 0,0:00:47.67,0:00:51.94,Default,U,0,0,0,,接下來我想嘗嘗創真君你的料理呢
Dialogue: 0,0:00:55.06,0:00:58.30,Default,,0,0,0,,你究竟會做出怎樣的菜品呢
Dialogue: 0,0:00:59.99,0:01:00.75,Default,U,0,0,0,,讓我見識一下吧
Dialogue: 0,0:01:02.10,0:01:05.99,Default,U,0,0,0,,你的料理物語
Dialogue: 0,0:01:10.02,0:01:12.24,Default,S,0,0,0,,老爹把我送到這裡來的理由
Dialogue: 0,0:01:12.76,0:01:14.59,Default,S,0,0,0,,我似乎稍微明白了一點
Dialogue: 0,0:01:20.09,0:01:20.87,Default,,0,0,0,,請稍候片刻！
Dialogue: 0,0:03:04.97,0:03:06.38,Default,,0,0,0,,一色學長的料理
Dialogue: 0,0:03:06.98,0:03:08.99,Default,,0,0,0,,「山椒烤鮫魚佐菜泥」
Dialogue: 0,0:03:10.03,0:03:13.66,Default,,0,0,0,,學長家裡莫非是開割烹料理店的嗎？
Dialogue: 0,0:03:14.36,0:03:15.85,Default,,0,0,0,,你為什麼會這麼想
Dialogue: 0,0:03:16.09,0:03:19.40,Default,,0,0,0,,山椒烤鮫魚不僅是和食的常規菜譜
Dialogue: 0,0:03:19.89,0:03:22.81,Default,,0,0,0,,而且這樣的精品也不是隨便什麼店家都能做出來的
Dialogue: 0,0:03:26.29,0:03:28.84,Default,,0,0,0,,細膩烤制出來的鮫魚塊
Dialogue: 0,0:03:29.72,0:03:32.17,Default,,0,0,0,,以春季的捲心菜為主料的菜泥也給人意外的感受
Dialogue: 0,0:03:33.99,0:03:37.08,Default,,0,0,0,,還有這入口即溶的甘甜柔嫩
Dialogue: 0,0:03:37.46,0:03:39.01,Default,,0,0,0,,與鮫魚堪稱絕配
Dialogue: 0,0:03:39.86,0:03:42.44,Default,,0,0,0,,春季時令鮫魚和春季捲心菜
Dialogue: 0,0:03:43.21,0:03:45.42,Default,,0,0,0,,兩者能互相提味的絕佳組合
Dialogue: 0,0:03:48.08,0:03:51.19,Default,,0,0,0,,如同春天萬物復蘇般的華麗！
Dialogue: 0,0:03:53.79,0:03:54.49,Default,,0,0,0,,鮫魚…
Dialogue: 0,0:03:55.91,0:03:59.46,Default,,0,0,0,,好！「幸平」秘密功能表中的第20號可以用上
Dialogue: 0,0:04:00.07,0:04:00.80,Default,,0,0,0,,「幸平」？
Dialogue: 0,0:04:01.13,0:04:03.05,Default,,0,0,0,,我家的小飯店啦
Dialogue: 0,0:04:03.89,0:04:05.62,Default,,0,0,0,,我也用鮫魚進行料理
Dialogue: 0,0:04:06.66,0:04:08.10,Default,,0,0,0,,將「幸平」的人氣料理
Dialogue: 0,0:04:08.60,0:04:11.14,Default,,0,0,0,,和學長一樣  以「春」為主題奉上
Dialogue: 0,0:04:21.89,0:04:23.35,Default,,0,0,0,,我睡著了嗎
Dialogue: 0,0:04:23.95,0:04:26.89,Default,,0,0,0,,不好！大米飲料喝多了
Dialogue: 0,0:04:31.24,0:04:33.34,Default,,0,0,0,,幸平在做菜？
Dialogue: 0,0:04:33.63,0:04:35.59,Default,,0,0,0,,他還餓著嗎？
Dialogue: 0,0:04:36.05,0:04:37.42,Default,,0,0,0,,是料理對決
Dialogue: 0,0:04:37.96,0:04:39.28,Default,,0,0,0,,伊武崎你醒著的啊
Dialogue: 0,0:04:39.56,0:04:41.28,Default,S,0,0,0,,那兩人在進行對決？
Dialogue: 0,0:04:41.58,0:04:42.50,Default,S,0,0,0,,為什麼為什麼？
Dialogue: 0,0:04:42.85,0:04:45.47,Default,,0,0,0,,不清楚  不過這場比賽
Dialogue: 0,0:04:45.99,0:04:47.88,Default,,0,0,0,,是一色學長提出的
Dialogue: 0,0:04:53.64,0:04:56.67,Default,,0,0,0,,這個場合  不吐槽一下學長的著裝嗎
Dialogue: 0,0:04:56.95,0:04:59.84,Default,,0,0,0,,難道的比賽  壞了氣氛可不太好
Dialogue: 0,0:04:59.93,0:05:00.73,Default,,0,0,0,,說的是呢
Dialogue: 0,0:05:06.42,0:05:07.24,Default,,0,0,0,,完成了
Dialogue: 0,0:05:08.07,0:05:10.52,Default,,0,0,0,,「幸平」秘密菜單其20改
Dialogue: 0,0:05:11.27,0:05:12.78,Default,,0,0,0,,「鮫魚茶泡飯團」
Dialogue: 0,0:05:13.89,0:05:15.86,Default,,0,0,0,,本來應該用鮭魚來做的
Dialogue: 0,0:05:16.50,0:05:18.78,Default,,0,0,0,,今天挑戰了一下鮫魚版本
Dialogue: 0,0:05:19.55,0:05:22.20,Default,,0,0,0,,大家的份都做了  請一齊品嘗吧
Dialogue: 0,0:05:23.51,0:05:24.37,Default,,0,0,0,,謝謝
Dialogue: 0,0:05:25.05,0:05:26.59,Default,,0,0,0,,倒進去的是什麼？
Dialogue: 0,0:05:26.91,0:05:27.94,Default,,0,0,0,,是鹽海帶茶
Dialogue: 0,0:05:28.33,0:05:29.80,Default,,0,0,0,,淡淡的鹹味和醇香
Dialogue: 0,0:05:30.02,0:05:31.76,Default,,0,0,0,,作為用餐的收尾再合適不過了
Dialogue: 0,0:05:32.09,0:05:36.22,Default,,0,0,0,,真是的  端上來這樣的菜肯定會叫人肚子餓啊
Dialogue: 0,0:05:36.57,0:05:37.36,Default,,0,0,0,,說的是啊
Dialogue: 0,0:05:38.95,0:05:42.05,Default,,0,0,0,,但這看起來簡直是不能再普通的茶泡飯
Dialogue: 0,0:05:42.79,0:05:45.99,Default,S,0,0,0,,的確像是會在家常菜館中端出來的菜
Dialogue: 0,0:05:46.62,0:05:47.24,Default,S,0,0,0,,  那麼…
Dialogue: 0,0:05:48.21,0:05:51.45,Default,,0,0,0,,讓我趕快嘗嘗  我開動啦！
Dialogue: 0,0:05:51.77,0:05:52.63,Default,,0,0,0,,我開動了
Dialogue: 0,0:06:00.19,0:06:00.82,Default,,0,0,0,,好吃！
Dialogue: 0,0:06:01.42,0:06:03.35,Default,,0,0,0,,鮫魚飽滿多汁
Dialogue: 0,0:06:03.83,0:06:05.90,Default,,0,0,0,,最重要的是魚皮的酥脆口感
Dialogue: 0,0:06:06.35,0:06:08.60,Default,,0,0,0,,每次咀嚼  美味都會噴湧而出
Dialogue: 0,0:06:08.93,0:06:11.53,Default,,0,0,0,,僅僅簡單烤一下可是不會有這麼好的口感
Dialogue: 0,0:06:11.87,0:06:12.90,Default,,0,0,0,,到底是怎麼做到的
Dialogue: 0,0:06:13.66,0:06:14.30,Default,,0,0,0,,是生煎
Dialogue: 0,0:06:15.57,0:06:16.34,Default,,0,0,0,,這鮫魚
Dialogue: 0,0:06:17.01,0:06:18.47,Default,,0,0,0,,是生煎出來的
Dialogue: 0,0:06:18.86,0:06:19.36,Default,F,0,0,0,,生{\1aFF\3aFF\4aFF}煎？
Dialogue: 0,0:06:19.36,0:06:19.82,Default,F,0,0,0,,生煎{\1aFF\3aFF\4aFF}？
Dialogue: 0,0:06:19.82,0:06:20.32,Default,F,0,0,0,,生煎？{\1aFF\3aFF\4aFF}
Dialogue: 0,0:06:20.49,0:06:22.37,Default,,0,0,0,,為什麼你也表現得很吃驚啊
Dialogue: 0,0:06:22.52,0:06:25.66,Default,,0,0,0,,我在想生煎是個什麼東西…
Dialogue: 0,0:06:25.85,0:06:26.37,Default,,0,0,0,,啥？
Dialogue: 0,0:06:26.99,0:06:32.22,Default,,0,0,0,,所謂生煎  是法國料理中烤制食材的一種方法
Dialogue: 0,0:06:32.45,0:06:38.92,0wrt,F,0,0,0,,{\1c1C3CA8\fn方正小標宋_GBK\pos(1138,440)}生煎
Dialogue: 0,0:06:33.63,0:06:35.88,Default,,0,0,0,,在素材上澆上橄欖油
Dialogue: 0,0:06:36.50,0:06:38.43,Default,,0,0,0,,將它們烤制得顏色均勻的方法
Dialogue: 0,0:06:39.34,0:06:41.26,Default,S,0,0,0,,創真君  你能告訴我
Dialogue: 0,0:06:42.06,0:06:44.83,Default,S,0,0,0,,你為什麼會知道法國料理的料理方法嗎？
Dialogue: 0,0:06:45.19,0:06:48.81,Default,,0,0,0,,這個烤制方法是和我家老爹學的
Dialogue: 0,0:06:49.25,0:06:51.96,Default,,0,0,0,,要把魚做得酥脆用這個方法再合適不過了
Dialogue: 0,0:06:52.57,0:06:54.79,Default,,0,0,0,,既香酥鬆脆可以下飯
Dialogue: 0,0:06:55.41,0:06:57.80,Default,,0,0,0,,泡在海帶茶裡面稍微入一點味
Dialogue: 0,0:06:58.16,0:07:00.04,Default,,0,0,0,,又會有不一樣的味道讓人期待
Dialogue: 0,0:07:02.47,0:07:05.04,Default,,0,0,0,,你的父親學過法國料理嗎？
Dialogue: 0,0:07:05.45,0:07:08.05,Default,,0,0,0,,這個嘛  我也不太清楚啊
Dialogue: 0,0:07:08.50,0:07:11.50,Default,,0,0,0,,不過他好像在世界各國做料理
Dialogue: 0,0:07:11.97,0:07:12.71,Default,,0,0,0,,原來如此
Dialogue: 0,0:07:13.54,0:07:16.48,Default,,0,0,0,,想不到會用法式技法來做飯的配菜
Dialogue: 0,0:07:17.20,0:07:18.76,Default,,0,0,0,,不受國境和種類的限制
Dialogue: 0,0:07:19.33,0:07:20.94,Default,,0,0,0,,這是一道多麼自由的料理
Dialogue: 0,0:07:21.88,0:07:25.15,Default,,0,0,0,,並且生煎適合於皮有一定厚度的食材
Dialogue: 0,0:07:25.89,0:07:28.97,Default,,0,0,0,,鮭魚和鮫魚  正完全符合條件
Dialogue: 0,0:07:30.01,0:07:31.82,Default,,0,0,0,,創真他在瞬間就看透這點
Dialogue: 0,0:07:32.55,0:07:34.02,Default,,0,0,0,,明確了如何組成這道菜
Dialogue: 0,0:07:35.33,0:07:38.15,Default,,0,0,0,,閃耀著純白光輝的米飯宛若白雪
Dialogue: 0,0:07:44.13,0:07:46.72,Default,,0,0,0,,奮力躍出其中的鮫魚
Dialogue: 0,0:07:47.31,0:07:49.17,Default,,0,0,0,,正是春天的生命力最好的體現
Dialogue: 0,0:07:50.76,0:07:55.35,Default,,0,0,0,,他用這道菜表現出了春天開始綻放的那一瞬間！
Dialogue: 0,0:08:40.06,0:08:40.62,Default,,0,0,0,,發…
Dialogue: 0,0:08:42.68,0:08:43.33,Default,,0,0,0,,發…
Dialogue: 0,0:08:46.16,0:08:47.12,Default,,0,0,0,,發芽了！
Dialogue: 0,0:08:49.10,0:08:49.92,Default,,0,0,0,,招待不周！
Dialogue: 0,0:08:52.42,0:08:53.12,Default,,0,0,0,,真是美麗…
Dialogue: 0,0:08:53.94,0:08:56.75,Default,,0,0,0,,真是美輪美奐的融雪  創真君
Dialogue: 0,0:08:57.14,0:08:58.35,Default,,0,0,0,,學長你才是
Dialogue: 0,0:08:59.09,0:09:02.23,Default,,0,0,0,,  讓我切身感受到了清爽暢快的春風拂面
Dialogue: 0,0:09:02.84,0:09:04.08,Default,,0,0,0,,謝謝你讓我體驗了一場如此棒的比賽
Dialogue: 0,0:09:13.89,0:09:15.85,Default,,0,0,0,,這是什麼狀況？
Dialogue: 0,0:09:15.91,0:09:19.50,0wrt,F,0,0,0,,{\fn@方正小標宋_GBK\an4\frz-90\1c2C2C2C\fs22\pos(161,120)}雙目含淚的半裸男
Dialogue: 0,0:09:15.91,0:09:19.50,0wrt,F,0,0,0,,{\fn@方正小標宋_GBK\an4\frz-90\1c2C2C2C\fs22\pos(135,120)}和同級男生的
Dialogue: 0,0:09:15.91,0:09:19.50,0wrt,F,0,0,0,,{\fn@方正小標宋_GBK\an4\frz-90\1c2C2C2C\fs22\pos(109,120)}握手圖
Dialogue: 0,0:09:24.86,0:09:27.95,Default,,0,0,0,,丸井  丸井  丸井！
Dialogue: 0,0:09:29.46,0:09:30.82,Default,,0,0,0,,看樣子是起不來了
Dialogue: 0,0:09:31.14,0:09:31.84,Default,,0,0,0,,是呢
Dialogue: 0,0:09:36.38,0:09:37.36,Default,,0,0,0,,那麼解散！
Dialogue: 0,0:09:38.19,0:09:41.17,Default,,0,0,0,,丸井  下次我們肯定會整理好再走的
Dialogue: 0,0:09:41.35,0:09:43.85,Default,,0,0,0,,對對  下次肯定整理  真真的
Dialogue: 0,0:09:47.74,0:09:52.06,Default,,0,0,0,,說起來一色學長為什麼要進行料理比賽呢
Dialogue: 0,0:09:52.37,0:09:54.54,Default,,0,0,0,,誰知道呢  他是個一時興起的人嘛
Dialogue: 0,0:09:54.84,0:09:58.48,Default,,0,0,0,,就算我們在乎那個怪人的想法也得不到答案的
Dialogue: 0,0:09:58.67,0:09:59.88,Default,,0,0,0,,好困
Dialogue: 0,0:10:02.79,0:10:03.99,Default,,0,0,0,,惠  晚安啦
Dialogue: 0,0:10:04.30,0:10:05.78,Default,,0,0,0,,晚安
Dialogue: 0,0:10:07.01,0:10:11.58,Default,,0,0,0,,創真君  這場歡迎會之後  你也是極星的一員了
Dialogue: 0,0:10:13.97,0:10:16.62,Default,,0,0,0,,有什麼不清楚的地方隨時都可以來問我
Dialogue: 0,0:10:18.03,0:10:21.59,Default,,0,0,0,,那怎麼才能進入十傑呢？
Dialogue: 0,0:10:29.51,0:10:30.36,Default,S,0,0,0,,說的是啊
Dialogue: 0,0:10:31.23,0:10:34.08,Default,S,0,0,0,,你想要站上這個學園的頂點呢
Dialogue: 0,0:10:34.69,0:10:37.99,Default,,0,0,0,,如此執念  是否有什麼理由呢？
Dialogue: 0,0:10:38.50,0:10:41.75,Default,,0,0,0,,其實我現在正在和老爹吵架
Dialogue: 0,0:10:42.60,0:10:46.36,Default,,0,0,0,,要得到老爹認同我必須這樣
Dialogue: 0,0:10:47.39,0:10:49.53,Default,,0,0,0,,剛才的比賽雖然是平手
Dialogue: 0,0:10:51.82,0:10:53.19,Default,,0,0,0,,但如果下次我贏了學長
Dialogue: 0,0:10:53.97,0:10:56.16,Default,,0,0,0,,我就能為遠月的第七嗎？
Dialogue: 0,0:10:59.89,0:11:01.45,Default,,0,0,0,,太棒了！
Dialogue: 0,0:11:01.78,0:11:04.48,Default,,0,0,0,,創真君  你的上進心真是棒極了
Dialogue: 0,0:11:05.00,0:11:07.25,Default,,0,0,0,,我現在超級感動
Dialogue: 0,0:11:07.66,0:11:09.16,Default,,0,0,0,,住在極星的學生
Dialogue: 0,0:11:09.46,0:11:12.20,Default,,0,0,0,,必須要這樣的上進心！
Dialogue: 0,0:11:12.55,0:11:14.75,Default,,0,0,0,,但今天就到這裡吧
Dialogue: 0,0:11:16.00,0:11:19.46,Default,,0,0,0,,夜也深了  我們也休息吧  創真君
Dialogue: 0,0:11:20.46,0:11:22.37,Default,,0,0,0,,說的也是…
Dialogue: 0,0:11:23.36,0:11:25.08,Default,,0,0,0,,站上遠月的頂點
Dialogue: 0,0:11:25.98,0:11:30.37,Default,,0,0,0,,你說出的話所帶來的重擔  才剛剛開始
Dialogue: 0,0:11:31.27,0:11:34.09,Default,U,0,0,0,,那啥  我叫幸平創真
Dialogue: 0,0:11:34.66,0:11:38.49,Default,U,0,0,0,,說實話  我認為這個學園也就是個踏板
Dialogue: 0,0:11:39.23,0:11:40.34,Default,,0,0,0,,我會登峰
Dialogue: 0,0:11:41.09,0:11:42.74,Default,,0,0,0,,你也會漸漸體會到吧
Dialogue: 0,0:11:43.88,0:11:46.43,Default,,0,0,0,,這個學校就如字面所述
Dialogue: 0,0:11:47.42,0:11:48.98,Default,,0,0,0,,料理就是全部
Dialogue: 3,0:11:58.86,0:12:03.78,0wrt,F,0,0,0,,{\fn方正黑體_GBK\1c34567C\bord0\shad0\an7\b1\fs32\pos(308,13)}{\1aFF}{\t(0,200,\1a00)}學{\1aFF}{\t(200,400,\1a00)}園{\1aFF}{\t(400,600,\1a00)}總{\1aFF}{\t(600,800,\1a00)}帥{\1aFF}{\t(800,1000,\1a00)}殿{\1aFF}{\t(1000,1200,\1a00)}下{\1aFF}{\t(1200,1400,\1a00)}：
Dialogue: 6,0:12:00.82,0:12:01.12,0wrt,F,0,0,0,,{\fn方正黑體_GBK\1c34567C\bord0\shad0\an7\b1\fs32\move(501,43,501,13)\clip(453,14,1049,43)}本文書  是剛剛結束的{\1c253E58}食戟{\1c1c34567C}的戰績的報告
Dialogue: 6,0:12:01.12,0:12:02.51,0wrt,F,0,0,0,,{\fn方正黑體_GBK\1c34567C\bord0\shad0\an7\b1\fs32\pos(501,13)\clip(453,14,1049,43)}本文書  是剛剛結束的{\1c253E58}食戟{\1c1c34567C}的戰績的報告
Dialogue: 6,0:12:02.51,0:12:02.81,0wrt,F,0,0,0,,{\fn方正黑體_GBK\1c34567C\bord0\shad0\an7\b1\fs32\move(501,13,501,-23)\clip(453,14,1049,43)}本文書  是剛剛結束的{\1c253E58}食戟{\1c1c34567C}的戰績的報告
Dialogue: 6,0:12:02.51,0:12:02.81,0wrt,F,0,0,0,,{\fn方正黑體_GBK\1c34567C\bord0\shad0\an7\b1\fs32\move(501,43,501,13)\clip(453,14,1049,43)}開戰日  3月16日  下午4點02分
Dialogue: 6,0:12:02.81,0:12:03.78,0wrt,F,0,0,0,,{\fn方正黑體_GBK\1c34567C\bord0\shad0\an7\b1\fs32\pos(501,13)\clip(453,14,1049,43)}開戰日  3月16日  下午4點02分
Dialogue: 0,0:12:07.85,0:12:09.57,Default,U,0,0,0,,主食材是雞蛋
Dialogue: 0,0:12:10.29,0:12:11.49,Default,U,0,0,0,,用它做一道菜
Dialogue: 0,0:12:12.29,0:12:14.50,Default,U,0,0,0,,只有能做出滿足我舌頭的菜品的人
Dialogue: 0,0:12:14.98,0:12:17.42,Default,U,0,0,0,,才能允許進入遠月學園
Dialogue: 0,0:12:18.34,0:12:20.11,Default,U,0,0,0,,趕快把碗端過來！
Dialogue: 0,0:12:20.50,0:12:22.04,Default,U,0,0,0,,難吃死了
Dialogue: 0,0:12:22.34,0:12:23.46,Default,U,0,0,0,,我先說清楚了
Dialogue: 0,0:12:23.79,0:12:25.44,Default,U,0,0,0,,我還沒有認同你
Dialogue: 0,0:12:25.76,0:12:27.82,Default,U,0,0,0,,包括你的料理在內
Dialogue: 0,0:12:28.16,0:12:29.61,Default,U,0,0,0,,你說你要登上頂點？
Dialogue: 0,0:12:30.05,0:12:31.03,Default,U,0,0,0,,別讓人發笑了
Dialogue: 0,0:12:31.70,0:12:34.06,Default,U,0,0,0,,從初中部升上來的內部升學者們
Dialogue: 0,0:12:34.46,0:12:36.73,Default,U,0,0,0,,都學習了最先進的美食學
Dialogue: 0,0:12:37.39,0:12:38.94,Default,U,0,0,0,,不要說觸其項背
Dialogue: 0,0:12:39.46,0:12:43.33,Default,U,0,0,0,,你這樣的外來生源  根本不可能贏過他們
Dialogue: 0,0:12:57.79,0:12:59.98,Default,,0,0,0,,發酵了
Dialogue: 0,0:13:02.79,0:13:05.57,Default,,0,0,0,,小兔…
Dialogue: 0,0:13:09.85,0:13:10.45,Default,,0,0,0,,好重
Dialogue: 0,0:13:14.94,0:13:17.38,Default,,0,0,0,,大家早上好
Dialogue: 0,0:13:18.97,0:13:22.77,Default,,0,0,0,,啊  每次都把我房間弄得這麼亂
Dialogue: 0,0:13:23.27,0:13:27.92,Default,,0,0,0,,今天一定要比以前更嚴厲更嚴厲地教訓他們
Dialogue: 0,0:13:30.81,0:13:31.86,Default,,0,0,0,,早
Dialogue: 0,0:13:31.95,0:13:33.17,Default,,0,0,0,,早
Dialogue: 0,0:13:36.00,0:13:38.00,Default,,0,0,0,,什麼啊  怎麼了
Dialogue: 0,0:13:41.35,0:13:43.38,Default,,0,0,0,,昨天將話擱置下來了呢
Dialogue: 0,0:13:43.94,0:13:46.89,Default,,0,0,0,,賭上十傑第七席的名譽
Dialogue: 0,0:13:47.75,0:13:49.69,Default,,0,0,0,,來一決勝負  一色前輩！
Dialogue: 0,0:14:04.10,0:14:04.56,Default,,0,0,0,,嗯？
Dialogue: 0,0:14:05.18,0:14:06.00,Default,,0,0,0,,吃飯吃飯
Dialogue: 0,0:14:06.09,0:14:07.61,Default,,0,0,0,,餓死我了
Dialogue: 0,0:14:07.67,0:14:09.09,Default,,0,0,0,,文緒姐還沒好嗎
Dialogue: 0,0:14:09.16,0:14:10.73,Default,,0,0,0,,嘰嘰喳喳吵死了
Dialogue: 0,0:14:10.84,0:14:12.05,Default,,0,0,0,,給我老實坐著
Dialogue: 0,0:14:13.14,0:14:14.38,Default,,0,0,0,,不好意思  創真君
Dialogue: 0,0:14:15.18,0:14:16.42,Default,,0,0,0,,我沒有好好說明呢
Dialogue: 0,0:14:17.86,0:14:20.67,Default,,0,0,0,,關於遠月學院的決鬥
Dialogue: 0,0:14:25.95,0:14:27.71,8para,,0,0,0,,繪理奈大人
Dialogue: 0,0:14:28.25,0:14:30.22,8para,,0,0,0,,加油啊
Dialogue: 0,0:14:30.25,0:14:32.09,8para,,0,0,0,,加油啊
Dialogue: 0,0:14:33.38,0:14:35.23,Default,,0,0,0,,放馬過來
Dialogue: 0,0:14:43.72,0:14:45.77,Default,,0,0,0,,我們什錦火鍋研究會
Dialogue: 0,0:14:46.14,0:14:47.86,Default,,0,0,0,,是自學院創立以來就一直存在的
Dialogue: 0,0:14:48.07,0:14:50.40,Default,,0,0,0,,淵源深遠的研究會
Dialogue: 0,0:14:48.82,0:14:50.82,0wrt,F,0,0,0,,{\fad(410,0)\fn方正小標宋_GBK\1c313131\3cFFFFFF\3a20\blur0.2\bord1.3\b1\fsp1\fscx90\fs24\pos(948.4,276)}豪田林  清志
Dialogue: 0,0:14:48.82,0:14:50.82,0wrt,F,0,0,0,,{\fad(410,0)\fn方正小標宋_GBK\1c313131\3cFFFFFF\3a20\blur0.2\bord1.3\b1\fsp1\fscx85\fs23\pos(945.4,424)}什錦火鍋研究會  第76代主將
Dialogue: 0,0:14:51.61,0:14:55.97,Default,,0,0,0,,你要把我們的活動室拆掉來建什麼？  薙切君
Dialogue: 0,0:14:56.57,0:14:58.60,Default,,0,0,0,,我的專用料理棟
Dialogue: 0,0:14:59.04,0:15:00.63,Default,,0,0,0,,第五棟也快容不下了
Dialogue: 0,0:15:00.69,0:15:01.39,Default,,0,0,0,,想建第六…
Dialogue: 0,0:15:01.43,0:15:02.34,Default,,0,0,0,,別開玩笑了！
Dialogue: 0,0:15:02.68,0:15:08.00,Default,,0,0,0,,那所建築存留著前輩們留下的對料理的熱情還有歷史
Dialogue: 0,0:15:08.50,0:15:10.02,Default,,0,0,0,,你現在居然想要踐踏這一切
Dialogue: 0,0:15:10.18,0:15:12.04,Default,,0,0,0,,你這樣還能算是廚師嗎
Dialogue: 0,0:15:12.26,0:15:13.35,Default,,0,0,0,,對  沒錯啊
Dialogue: 0,0:15:13.41,0:15:14.59,Default,,0,0,0,,絕不允許暴行
Dialogue: 0,0:15:15.13,0:15:16.05,Default,,0,0,0,,繪理奈大人
Dialogue: 0,0:15:18.57,0:15:21.07,Default,,0,0,0,,只是一味的模仿那些前輩的配方
Dialogue: 0,0:15:21.51,0:15:25.94,Default,,0,0,0,,你所說的料理的熱情就是不停地浪費預算嗎
Dialogue: 0,0:15:26.25,0:15:26.76,Default,,0,0,0,,什！
Dialogue: 0,0:15:27.39,0:15:30.02,Default,,0,0,0,,這幾年來沒有一例出彩的戰績
Dialogue: 0,0:15:30.67,0:15:33.36,Default,,0,0,0,,遠月不需要這種
Dialogue: 0,0:15:34.01,0:15:35.87,Default,,0,0,0,,只會吹噓光輝歷史的研究會
Dialogue: 0,0:15:36.27,0:15:38.29,Default,,0,0,0,,仗著權勢為所欲為
Dialogue: 0,0:15:38.90,0:15:40.87,Default,,0,0,0,,這次絕不容忍你
Dialogue: 0,0:15:41.25,0:15:42.07,Default,,0,0,0,,如果我贏了
Dialogue: 0,0:15:42.34,0:15:43.69,Default,,0,0,0,,你就從第十席的寶座上下來吧
Dialogue: 0,0:15:44.11,0:15:46.57,Default,,0,0,0,,一決勝負  薙切繪理奈
Dialogue: 0,0:15:46.93,0:15:48.19,Default,,0,0,0,,那麼如果我贏了
Dialogue: 0,0:15:48.47,0:15:50.49,Default,,0,0,0,,就按計劃繼續施工了
Dialogue: 0,0:15:51.19,0:15:55.00,Default,,0,0,0,,來較量一下吧  豪田林學長
Dialogue: 0,0:15:57.48,0:16:02.87,Default,,0,0,0,,在這所學園裡  制定有為解決學生之間糾紛的制度
Dialogue: 0,0:16:03.75,0:16:06.18,Default,,0,0,0,,其中有幾項規定
Dialogue: 0,0:16:07.25,0:16:10.88,Default,,0,0,0,,創真君想挑戰我第七席的席位的話
Dialogue: 0,0:16:11.60,0:16:14.54,Default,,0,0,0,,必須付出與其相等的代價
Dialogue: 0,0:16:15.40,0:16:17.35,Default,,0,0,0,,與第七席相等的代價？
Dialogue: 0,0:16:17.90,0:16:20.39,Default,,0,0,0,,與第七席等價的條件的話…
Dialogue: 0,0:16:21.27,0:16:23.24,Default,,0,0,0,,即使是讓你退學都不夠啊
Dialogue: 0,0:16:23.39,0:16:24.55,Default,P,0,0,0,,真的假的!?
Dialogue: 0,0:16:24.66,0:16:25.11,Default,,0,0,0,,沒錯
Dialogue: 0,0:16:25.73,0:16:27.92,Default,,0,0,0,,十傑的價值確實如此
Dialogue: 0,0:16:28.56,0:16:32.27,Default,,0,0,0,,不管怎麼說也是學院的最高決策機構
Dialogue: 0,0:16:32.78,0:16:37.41,Default,,0,0,0,,十傑決定的事就連老師們都沒法反抗
Dialogue: 0,0:16:38.15,0:16:43.26,Default,,0,0,0,,過去這個宿舍曾經出了多少個十傑啊
Dialogue: 0,0:16:43.49,0:16:46.27,Default,,0,0,0,,簡直就是極星的黃金時代
Dialogue: 0,0:16:46.74,0:16:49.15,Default,,0,0,0,,比起那些  你們現在真是丟人
Dialogue: 0,0:16:50.22,0:16:52.22,Default,,0,0,0,,文緒小姐又開始說這個了啊
Dialogue: 0,0:16:52.53,0:16:53.88,Default,,0,0,0,,所以這樣
Dialogue: 0,0:16:54.23,0:16:56.99,Default,,0,0,0,,雖然我同意的話還是可以開戰
Dialogue: 0,0:16:57.44,0:17:00.42,Default,,0,0,0,,當然我不想讓你退學
Dialogue: 0,0:17:01.04,0:17:01.58,Default,,0,0,0,,結論
Dialogue: 0,0:17:01.91,0:17:03.81,Default,,0,0,0,,達不成比賽的條件
Dialogue: 0,0:17:04.71,0:17:08.56,Default,,0,0,0,,不是吧  今天早上五點就起床鼓足幹勁的
Dialogue: 0,0:17:08.85,0:17:11.25,Default,,0,0,0,,話說回來挑戰第七席什麼的
Dialogue: 0,0:17:11.54,0:17:12.59,Default,,0,0,0,,太亂來了
Dialogue: 0,0:17:12.83,0:17:14.82,Default,,0,0,0,,也許他就是個笨蛋吧
Dialogue: 0,0:17:14.99,0:17:17.74,Default,,0,0,0,,而且也不是想開戰就開戰的
Dialogue: 0,0:17:18.75,0:17:20.71,Default,,0,0,0,,開戰的條件有三個
Dialogue: 0,0:17:21.29,0:17:25.26,Default,,0,0,0,,第一  承認比賽的正式性的認定員
Dialogue: 0,0:17:25.76,0:17:27.87,Default,,0,0,0,,第二  奇數個的判定員
Dialogue: 0,0:17:28.30,0:17:32.28,Default,,0,0,0,,第三  對戰兩人對勝負條件的合意
Dialogue: 0,0:17:33.52,0:17:35.54,Default,,0,0,0,,滿足以上三個最基本的條件較量才能成立
Dialogue: 0,0:17:35.95,0:17:38.19,Default,,0,0,0,,真麻煩
Dialogue: 0,0:17:38.44,0:17:39.69,Default,,0,0,0,,但是反過來說
Dialogue: 0,0:17:40.06,0:17:41.38,Default,,0,0,0,,只要滿足了這三點
Dialogue: 0,0:17:41.77,0:17:44.48,Default,,0,0,0,,這所學院的所有人你都可以挑戰
Dialogue: 0,0:17:46.47,0:17:50.25,Default,,0,0,0,,面對所有敵對者  都應用料理來制服
Dialogue: 0,0:17:51.32,0:17:53.34,Default,,0,0,0,,遠月傳統一對一較量
Dialogue: 0,0:17:54.05,0:17:54.69,Default,,0,0,0,,這就是…
Dialogue: 0,0:17:57.82,0:17:58.68,Default,,0,0,0,,食戟
Dialogue: 0,0:18:00.23,0:18:01.52,Default,,0,0,0,,審查結果已出
Dialogue: 0,0:18:02.18,0:18:05.74,Default,,0,0,0,,這場食戟的獲勝者是  薙切繪理奈！
Dialogue: 0,0:18:08.56,0:18:11.89,Default,P,0,0,0,,怎麼可能…居然完敗!?
Dialogue: 0,0:18:12.71,0:18:14.26,Default,,0,0,0,,我們的什錦研究會…
Dialogue: 0,0:18:15.42,0:18:19.93,Default,,0,0,0,,我的「伊勢蝦相撲什錦火鍋」到底差在哪了！
Dialogue: 0,0:19:17.45,0:19:21.41,Default,,0,0,0,,學長的料理共有27處不足
Dialogue: 0,0:19:22.09,0:19:25.66,Default,,0,0,0,,首先  伊勢蝦的解凍時間多了兩秒
Dialogue: 0,0:19:27.02,0:19:31.63,Default,,0,0,0,,然後是蛤蜊散發出的異味破壞了整口鍋的味道
Dialogue: 0,0:19:32.14,0:19:32.97,Default,,0,0,0,,閉嘴！
Dialogue: 0,0:19:33.20,0:19:34.75,Default,,0,0,0,,接著是蔬菜的搭配…
Dialogue: 0,0:19:34.75,0:19:35.70,Default,,0,0,0,,閉嘴！
Dialogue: 0,0:19:35.93,0:19:38.64,Default,,0,0,0,,那你的料理又怎樣呢
Dialogue: 0,0:19:39.03,0:19:42.42,Default,,0,0,0,,怎麼可能比我為了今日決戰苦心訓練做出的料理好吃…
Dialogue: 0,0:19:44.76,0:19:45.37,Default,,0,0,0,,開始！
Dialogue: 0,0:19:48.43,0:19:50.48,Default,,0,0,0,,如何？學長
Dialogue: 0,0:19:51.74,0:19:54.07,Default,,0,0,0,,我的「希伯來蝦餃」
Dialogue: 0,0:19:55.53,0:19:58.12,Default,,0,0,0,,蒸出來的鬆軟的蝦餃中
Dialogue: 0,0:19:58.39,0:20:01.06,Default,,0,0,0,,富含著草蝦的美味
Dialogue: 0,0:20:07.24,0:20:08.70,Default,,0,0,0,,這彈性十足的口感
Dialogue: 0,0:20:08.95,0:20:12.55,Default,,0,0,0,,就仿佛被橫綱單方面壓倒一般…
Dialogue: 0,0:20:13.75,0:20:15.83,Default,,0,0,0,,味道不在一個次元！
Dialogue: 0,0:20:16.54,0:20:18.20,Default,,0,0,0,,太棒了！
Dialogue: 0,0:20:28.25,0:20:29.10,Default,,0,0,0,,是我
Dialogue: 0,0:20:30.77,0:20:31.69,Default,,0,0,0,,請開始吧
Dialogue: 0,0:20:33.51,0:20:34.10,Default,,0,0,0,,要幹嘛
Dialogue: 0,0:20:35.13,0:20:38.58,Default,,0,0,0,,不要…不要啊
Dialogue: 0,0:20:42.24,0:20:44.20,Default,,0,0,0,,冷酷  慘無人道…
Dialogue: 0,0:20:45.01,0:20:47.62,Default,,0,0,0,,這就是…這就是
Dialogue: 0,0:20:48.77,0:20:51.27,Default,,0,0,0,,料理魔王的血族嗎！
Dialogue: 0,0:20:53.84,0:20:54.95,Default,,0,0,0,,貴安
Dialogue: 0,0:21:03.32,0:21:04.97,Default,,0,0,0,,食戟嗎…
Dialogue: 0,0:21:06.02,0:21:09.47,Default,,0,0,0,,還想找薙切挑戰來著
Dialogue: 0,0:21:10.06,0:21:12.90,Default,,0,0,0,,不…不可能贏的啦
Dialogue: 0,0:21:15.38,0:21:16.77,Default,,0,0,0,,今後很值得期待吧
Dialogue: 0,0:21:17.53,0:21:20.19,Default,,0,0,0,,他一定會收穫光榮戰績的
Dialogue: 0,0:21:20.97,0:21:22.86,Default,,0,0,0,,不管怎麼說也是和我打了平手
Dialogue: 0,0:21:23.51,0:21:25.07,Default,,0,0,0,,和這個第七席的我啊
Dialogue: 0,0:21:26.06,0:21:27.35,Default,,0,0,0,,你也是這麼想的吧
Dialogue: 0,0:21:27.86,0:21:28.64,Default,,0,0,0,,伊武崎君
Dialogue: 0,0:21:28.86,0:21:30.38,Default,,0,0,0,,切  真會說
Dialogue: 0,0:21:30.85,0:21:32.87,Default,,0,0,0,,明明根本沒拿出真本事
Dialogue: 0,0:21:33.33,0:21:34.92,Default,,0,0,0,,也沒有任何特點
Dialogue: 0,0:21:35.56,0:21:36.49,Default,,0,0,0,,那道料理對你來說
Dialogue: 0,0:21:36.89,0:21:39.78,Default,,0,0,0,,根本沒費半點心思吧
Dialogue: 0,0:21:41.38,0:21:42.55,Default,,0,0,0,,你說什麼呢？
Dialogue: 0,0:21:43.27,0:21:45.81,Default,,0,0,0,,我可是全心全意在做的
Dialogue: 0,0:21:46.82,0:21:48.91,Default,,0,0,0,,真是狡猾呢學長
Dialogue: 0,0:21:50.58,0:21:55.24,Default,,0,0,0,,創真君  品嘗你的料理的時候我就有預感
Dialogue: 0,0:21:56.72,0:21:58.86,Default,,0,0,0,,你這樣的新人
Dialogue: 0,0:22:01.22,0:22:06.40,Default,,0,0,0,,將引領綻放這所學園的食戟之花
Dialogue: 0,0:23:40.28,0:23:42.79,Default,,0,0,0,,真是出色的技術  繪理奈大人
Dialogue: 0,0:23:46.15,0:23:48.36,Default,,0,0,0,,那種人做對手  贏了都驕傲不起來
Dialogue: 0,0:23:48.96,0:23:50.57,Default,,0,0,0,,完全意料之中
Dialogue: 0,0:23:52.88,0:23:56.37,Default,,0,0,0,,遠月不需要不完美的東西
Dialogue: 0,0:23:57.22,0:23:58.67,Default,,0,0,0,,下一個目標的清單
Dialogue: 0,0:23:58.89,0:24:00.41,Default,,0,0,0,,誒？噢噢！好！
Dialogue: 0,0:24:01.03,0:24:01.73,Default,,0,0,0,,在這裡
Dialogue: 0,0:24:02.85,0:24:03.75,Default,,0,0,0,,繪理奈大人
Dialogue: 0,0:24:05.63,0:24:08.55,Default,,0,0,0,,下一個能讓我上嗎
Dialogue: 0,0:24:09.55,0:24:14.21,Default,,0,0,0,,那些雜魚  根本不必繪理奈大人你親自動手
Dialogue: 0,0:24:14.73,0:24:16.97,Default,,0,0,0,,請務必讓我為您效力
Dialogue: 0,0:24:17.22,0:24:17.97,Default,,0,0,0,,說的也是呢
Dialogue: 0,0:24:18.41,0:24:19.85,Default,,0,0,0,,聽起來挺有趣的
Dialogue: 0,0:24:20.47,0:24:23.35,Default,,0,0,0,,但是規矩你懂的吧？
Dialogue: 0,0:24:25.16,0:24:27.88,Default,,0,0,0,,被稱為肉的侵略者的我
Dialogue: 0,0:24:28.32,0:24:29.64,Default,,0,0,0,,一定不負其譽
Dialogue: 0,0:24:30.06,0:24:33.93,Default,,0,0,0,,奪得完美的勝利
Dialogue: 0,0:24:41.84,0:24:43.89,Default,,0,0,0,,下集  「食戟之靈」
Dialogue: 0,0:24:44.67,0:24:46.33,Default,,0,0,0,,已經是第六道菜了呢
Dialogue: 0,0:24:48.40,0:24:49.54,Default,,0,0,0,,肉之侵略者
Dialogue: 0,0:24:50.81,0:24:52.61,Default,,0,0,0,,太完美了
