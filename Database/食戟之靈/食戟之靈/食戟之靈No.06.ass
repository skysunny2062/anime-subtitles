Dialogue: 0,0:02:09.06,0:02:14.07,0wrt,epsd,0,0,0,,{\fad(1000,1000)\1c080000\3cFFFFFF\blur1\bord1.2\b1\move(286,479,286,449)}肉\N之\N侵\N略\N者
Dialogue: 0,0:00:04.47,0:00:05.21,Default,,0,0,0,,我說啊
Dialogue: 0,0:00:06.24,0:00:10.09,Default,,0,0,0,,要和我來做嗎？不做嗎？
Dialogue: 0,0:00:13.71,0:00:15.06,Default,,0,0,0,,來做吧
Dialogue: 0,0:00:16.51,0:00:17.77,Default,,0,0,0,,食戟
Dialogue: 0,0:01:52.21,0:01:53.36,Default,,0,0,0,,創真君早上好
Dialogue: 0,0:01:55.02,0:01:56.41,Default,,0,0,0,,有點事情想找你幫忙
Dialogue: 0,0:01:56.90,0:01:58.41,Default,,0,0,0,,換好衣服後能出來下嗎
Dialogue: 0,0:02:00.38,0:02:02.65,Default,,0,0,0,,昨天熬到很晚才睡
Dialogue: 0,0:02:02.79,0:02:04.75,Default,,0,0,0,,學長請找其他人吧
Dialogue: 0,0:02:05.75,0:02:06.99,Default,,0,0,0,,別說這種話嘛
Dialogue: 0,0:02:07.17,0:02:08.41,Default,,0,0,0,,居然在那裡啊！
Dialogue: 0,0:02:11.12,0:02:12.69,Default,,0,0,0,,幸平也被叫起來啦
Dialogue: 0,0:02:12.73,0:02:13.79,Default,,0,0,0,,吉野也是嗎
Dialogue: 0,0:02:13.84,0:02:15.74,Default,,0,0,0,,我們到底要幫什麼忙？
Dialogue: 0,0:02:15.89,0:02:17.86,Default,,0,0,0,,到後院的田裡收菜
Dialogue: 0,0:02:18.11,0:02:21.22,Default,,0,0,0,,真不得了  連食材都自己做啊
Dialogue: 0,0:02:23.02,0:02:25.64,Default,,0,0,0,,好食材是好料理的起點
Dialogue: 0,0:02:26.01,0:02:27.81,Default,,0,0,0,,這是我們宿舍的座右銘呐
Dialogue: 0,0:02:28.75,0:02:29.89,Default,,0,0,0,,是嗎
Dialogue: 0,0:02:33.85,0:02:38.07,Default,,0,0,0,,伊武崎會像那樣自己做薰制用的燃木
Dialogue: 0,0:02:39.03,0:02:41.33,Default,,0,0,0,,涼子擅長需要發酵的料理
Dialogue: 0,0:02:41.78,0:02:43.97,Default,,0,0,0,,她還有專用的工作房間呢
Dialogue: 0,0:02:46.37,0:02:51.09,Default,,0,0,0,,我也想像法國佈雷斯雞那樣弄一個極星雞出來
Dialogue: 0,0:02:51.49,0:02:53.42,Default,,0,0,0,,所以將它們放養
Dialogue: 0,0:02:56.37,0:02:58.02,Default,,0,0,0,,然後呢
Dialogue: 0,0:02:59.20,0:03:02.19,Default,,0,0,0,,以一色學長為中心運營的就是…
Dialogue: 0,0:03:03.98,0:03:04.53,Default,,0,0,0,,這裡！
Dialogue: 0,0:03:05.53,0:03:07.82,Default,,0,0,0,,栽培有十幾種蔬菜的農園
Dialogue: 0,0:03:15.94,0:03:18.46,Default,,0,0,0,,創真君  吉野君  早上好
Dialogue: 0,0:03:19.05,0:03:21.89,Default,,0,0,0,,晨起的勞動能讓心神健康喲
Dialogue: 0,0:03:22.77,0:03:24.15,Default,,0,0,0,,一起揮灑汗水吧
Dialogue: 0,0:03:25.91,0:03:26.52,Default,,0,0,0,,真搭！
Dialogue: 0,0:03:27.33,0:03:29.80,Default,,0,0,0,,瞭解食材是如何生長
Dialogue: 0,0:03:30.23,0:03:31.76,Default,,0,0,0,,也是料理學習中的一環
Dialogue: 0,0:03:32.28,0:03:33.93,Default,,0,0,0,,這裡叫做極星田
Dialogue: 0,0:03:34.74,0:03:37.65,Default,,0,0,0,,或者稱為一色田也可以的
Dialogue: 0,0:03:37.97,0:03:38.50,Default,,0,0,0,,那麼…
Dialogue: 0,0:03:38.55,0:03:39.30,Default,,0,0,0,,創真君
Dialogue: 0,0:03:40.31,0:03:42.66,Default,,0,0,0,,田所也來了啊
Dialogue: 0,0:03:43.17,0:03:46.11,Default,,0,0,0,,看  一色學長培育的蔬菜
Dialogue: 0,0:03:46.33,0:03:47.24,Default,,0,0,0,,看起來很好吃吧？
Dialogue: 0,0:03:47.67,0:03:48.67,Default,,0,0,0,,怎麼說呢
Dialogue: 0,0:03:48.96,0:03:50.76,Default,,0,0,0,,真是讓人心情舒暢的絕配人士呢
Dialogue: 0,0:03:50.83,0:03:51.34,Default,,0,0,0,,對啊
Dialogue: 0,0:03:51.58,0:03:53.78,Default,,0,0,0,,惠是極星的清涼劑喲
Dialogue: 0,0:03:57.44,0:03:59.31,Default,,0,0,0,,來  嘗一口
Dialogue: 0,0:03:59.67,0:04:00.80,Default,,0,0,0,,謝啦
Dialogue: 0,0:04:06.91,0:04:08.03,Default,,0,0,0,,好吃！
Dialogue: 0,0:04:08.62,0:04:10.49,Default,,0,0,0,,果肉緊致  非常甜
Dialogue: 0,0:04:10.92,0:04:12.94,Default,,0,0,0,,好吃得讓我想把這買回到我家店裡去
Dialogue: 0,0:04:13.24,0:04:14.62,Default,,0,0,0,,學長竟然能種出這麼好的…
Dialogue: 0,0:04:14.83,0:04:17.23,Default,,0,0,0,,說實話在這上面投入太多心思
Dialogue: 0,0:04:17.67,0:04:20.59,Default,,0,0,0,,多虧與此最近連課都沒能好好去上
Dialogue: 0,0:04:21.02,0:04:22.91,Default,,0,0,0,,感覺他這是本末倒置了…
Dialogue: 0,0:04:23.38,0:04:24.52,Default,,0,0,0,,久等啦
Dialogue: 0,0:04:33.91,0:04:34.79,8para,,0,0,0,,好就這個了
Dialogue: 0,0:04:36.89,0:04:38.44,8para,,0,0,0,,這個也好吃
Dialogue: 0,0:04:38.65,0:04:40.47,8para,,0,0,0,,創真君真是的  一直在吃
Dialogue: 0,0:04:40.68,0:04:41.41,8para,,0,0,0,,的確呢
Dialogue: 0,0:04:41.51,0:04:42.46,8para,,0,0,0,,有什麼關係嘛
Dialogue: 0,0:04:44.65,0:04:47.66,Default,,0,0,0,,大家  來吃早飯啦
Dialogue: 0,0:04:48.41,0:04:49.49,Default,,0,0,0,,腰好痛
Dialogue: 0,0:04:48.84,0:04:50.34,8para,,0,0,0,,肚子餓了呢
Dialogue: 0,0:04:50.72,0:04:52.67,Default,,0,0,0,,田所做的早飯嗎
Dialogue: 0,0:04:52.97,0:04:55.55,Default,,0,0,0,,是呀  餓了吧？請用
Dialogue: 0,0:04:57.44,0:04:58.22,Default,,0,0,0,,原來如此
Dialogue: 0,0:04:58.64,0:05:01.13,Default,,0,0,0,,小田所特製的三色飯糰呢
Dialogue: 0,0:05:01.51,0:05:02.67,Default,,0,0,0,,不錯不錯
Dialogue: 0,0:05:02.93,0:05:04.67,Default,,0,0,0,,田活之後的飯糰
Dialogue: 0,0:05:04.83,0:05:06.33,Default,,0,0,0,,我開動啦
Dialogue: 0,0:05:09.81,0:05:11.52,Default,,0,0,0,,真好吃！
Dialogue: 0,0:05:11.79,0:05:13.32,Default,,0,0,0,,這個用了蔥鹽汁吧
Dialogue: 0,0:05:13.78,0:05:16.61,Default,,0,0,0,,將煮熟的雞胸肉拌上蔥鹽汁
Dialogue: 0,0:05:16.81,0:05:18.97,Default,,0,0,0,,飯糰表面上也塗得飽滿
Dialogue: 0,0:05:19.38,0:05:21.87,Default,,0,0,0,,這鹹鹹的味道讓人喚起食欲呐
Dialogue: 0,0:05:22.05,0:05:25.05,Default,,0,0,0,,活動完身體之後會喜歡上鹹味呢
Dialogue: 0,0:05:25.36,0:05:26.59,Default,,0,0,0,,這是海帶嗎
Dialogue: 0,0:05:26.94,0:05:28.21,Default,,0,0,0,,飯糰必備食材呢
Dialogue: 0,0:05:31.61,0:05:33.68,Default,,0,0,0,,這是燉海帶和…芝士？
Dialogue: 0,0:05:34.04,0:05:38.55,Default,,0,0,0,,甜烹海味的濃厚的甜味和芝士意外地適合
Dialogue: 0,0:05:39.45,0:05:40.93,Default,,0,0,0,,那這最後一種是什麼？
Dialogue: 0,0:05:43.70,0:05:44.93,Default,,0,0,0,,好吃！
Dialogue: 0,0:05:45.29,0:05:47.31,Default,,0,0,0,,大蒜的味道叫人停不下來啊！
Dialogue: 0,0:05:47.68,0:05:50.18,Default,,0,0,0,,這個是大蒜醃豬肉
Dialogue: 0,0:05:53.40,0:05:57.06,Default,,0,0,0,,在之前上課的時候看到創真用了蜂蜜
Dialogue: 0,0:05:57.49,0:05:59.46,Default,,0,0,0,,我也努力嘗試了一下
Dialogue: 0,0:06:00.54,0:06:06.12,Default,,0,0,0,,將煮好的五花肉與大蒜  味增  酒和蜂蜜混合在一起醃制
Dialogue: 0,0:06:06.90,0:06:08.77,Default,,0,0,0,,發現這樣和米飯很搭
Dialogue: 0,0:06:09.00,0:06:11.30,Default,,0,0,0,,就切細加在飯糰裡了
Dialogue: 0,0:06:13.53,0:06:17.22,Default,,0,0,0,,有麥茶和焙茶  請選擇自己喜歡的喝吧
Dialogue: 0,0:06:26.17,0:06:28.72,Default,,0,0,0,,這就是小田所料理的魅力所在
Dialogue: 0,0:06:29.17,0:06:31.78,Default,,0,0,0,,能讓食用者心情舒緩
Dialogue: 0,0:06:32.13,0:06:35.52,Default,,0,0,0,,雞胸肉不失水分  豬肉也非常柔嫩
Dialogue: 0,0:06:35.81,0:06:37.87,Default,,0,0,0,,每樣都很用心做的呢
Dialogue: 0,0:06:40.08,0:06:42.30,Default,,0,0,0,,為什麼上課的時候做不出來呢？
Dialogue: 0,0:06:45.01,0:06:47.51,Default,,0,0,0,,我從以前開始就會在人前極度緊張
Dialogue: 0,0:06:48.49,0:06:52.77,Default,,0,0,0,,一緊張腦袋裡就一片空白  只會失敗
Dialogue: 0,0:06:53.16,0:06:54.86,Default,,0,0,0,,真是辛苦啊
Dialogue: 0,0:06:55.16,0:06:58.19,Default,,0,0,0,,小田所  做料理的時候要更加放鬆啊
Dialogue: 0,0:06:58.38,0:07:02.96,Default,,0,0,0,,惠肯定能成好廚師和好新娘
Dialogue: 0,0:07:04.65,0:07:05.80,Default,,0,0,0,,是這樣嗎
Dialogue: 0,0:07:08.85,0:07:10.39,Default,,0,0,0,,什麼  研究會？
Dialogue: 0,0:07:11.50,0:07:15.08,Default,,0,0,0,,連同主題在內的料理研究會在遠月有很多
Dialogue: 0,0:07:16.09,0:07:20.16,Default,,0,0,0,,比如說  大家在放學後聚在一起開發新功能表…
Dialogue: 0,0:07:20.73,0:07:23.54,Default,,0,0,0,,參加校外的料理比賽之類的
Dialogue: 0,0:07:24.05,0:07:27.39,Default,,0,0,0,,換成普通學校來說  就好比是社團活動吧
Dialogue: 0,0:07:27.79,0:07:31.15,Default,,0,0,0,,我加入了鄉土料理研究會
Dialogue: 0,0:07:36.54,0:07:38.45,Default,,0,0,0,,真的呢  和洋中…
Dialogue: 0,0:07:38.60,0:07:40.21,Default,,0,0,0,,從「宮廷料理」到「齋菜」
Dialogue: 0,0:07:40.49,0:07:42.20,Default,,0,0,0,,「發酵食品」和「乾貨」
Dialogue: 0,0:07:42.63,0:07:44.29,Default,,0,0,0,,這邊還有「車站便當」
Dialogue: 0,0:07:46.62,0:07:47.99,Default,,0,0,0,,「蓋澆飯研究會」？
Dialogue: 0,0:07:48.81,0:07:50.76,Default,,0,0,0,,說不準能作為店裡菜單的參考
Dialogue: 0,0:07:51.64,0:07:53.08,Default,,0,0,0,,去參觀一下吧
Dialogue: 0,0:07:53.37,0:07:54.20,Default,,0,0,0,, 走吧  田所
Dialogue: 0,0:07:55.19,0:07:56.10,Default,,0,0,0,,我也要去？
Dialogue: 0,0:08:04.25,0:08:05.79,Default,,0,0,0,,抱歉了你們請回吧
Dialogue: 0,0:08:06.48,0:08:10.05,Default,,0,0,0,,蓋飯研究會馬上就要面臨崩潰的命運了
Dialogue: 0,0:08:14.30,0:08:16.38,Default,,0,0,0,,你們叫幸平和田所是嗎
Dialogue: 0,0:08:17.17,0:08:18.23,Default,,0,0,0,,我是小西
Dialogue: 0,0:08:16.64,0:08:20.56,0wrt,F,0,0,0,,{\fad(410,0)\fn方正小標宋_GBK\1c313131\3cFFFFFF\3a20\blur0.2\bord1.3\b1\fsp1\fscx90\fs24\pos(1007.4,174)}小西寬一
Dialogue: 0,0:08:16.64,0:08:20.56,0wrt,F,0,0,0,,{\fad(410,0)\fn方正小標宋_GBK\1c313131\3cFFFFFF\3a20\blur0.2\bord1.3\b1\fsp1\fscx85\fs23\pos(1011.4,326)}蓋研的首領（蓋飯）
Dialogue: 0,0:08:18.82,0:08:20.47,Default,,0,0,0,,擔任這裡的主將
Dialogue: 0,0:08:20.92,0:08:24.70,Default,,0,0,0,,學長你沒事吧？無精打采的
Dialogue: 0,0:08:26.59,0:08:27.63,Default,,0,0,0,,你們就笑我吧
Dialogue: 0,0:08:27.94,0:08:29.83,Default,,0,0,0,,嘲笑保護不了蓋研的我吧
Dialogue: 0,0:08:33.04,0:08:35.57,Default,,0,0,0,,這是菜譜集嗎
Dialogue: 0,0:08:36.47,0:08:38.62,Default,,0,0,0,,好像是蓋研想出來的菜譜
Dialogue: 0,0:08:39.82,0:08:40.55,Default,,0,0,0,,我瞧瞧
Dialogue: 0,0:08:42.04,0:08:44.27,Default,,0,0,0,,從王道到變種都有啊
Dialogue: 0,0:08:44.61,0:08:46.54,Default,,0,0,0,,每一種上都下了功夫啊
Dialogue: 0,0:08:47.17,0:08:48.65,Default,,0,0,0,,每一單都很有趣啊
Dialogue: 0,0:08:49.37,0:08:51.25,Default,,0,0,0,,為什麼非得要破壞這裡？
Dialogue: 0,0:08:53.75,0:08:55.84,Default,,0,0,0,,你們能明白我的苦心嗎？
Dialogue: 0,0:08:56.68,0:08:58.68,Default,,0,0,0,,幸平！
Dialogue: 0,0:08:58.75,0:08:59.41,Default,,0,0,0,,他哭起來了啊…
Dialogue: 0,0:08:59.73,0:09:02.46,Default,,0,0,0,,蓋飯宗旨就是「快捷  美味  便宜」
Dialogue: 0,0:09:02.99,0:09:05.10,Default,,0,0,0,,一碗就能結束的男人味
Dialogue: 0,0:09:05.64,0:09:07.40,Default,,0,0,0,,為了奮鬥的男人而出的男兒飯
Dialogue: 0,0:09:07.97,0:09:11.14,Default,,0,0,0,,我…我作為一名男人
Dialogue: 0,0:09:11.50,0:09:15.29,Default,,0,0,0,,在磨礪出究極的蓋飯之前不能死！
Dialogue: 0,0:09:15.35,0:09:16.93,Default,,0,0,0,,這人好像好厲害哦
Dialogue: 0,0:09:16.99,0:09:18.84,Default,,0,0,0,,有些討人嫌的熱血啊
Dialogue: 0,0:09:19.83,0:09:20.76,Default,,0,0,0,,我的蓋研…
Dialogue: 0,0:09:21.53,0:09:23.26,Default,,0,0,0,,如果沒有薙切繪理奈這女人
Dialogue: 0,0:09:24.05,0:09:24.71,Default,,0,0,0,,薙切？
Dialogue: 0,0:09:25.28,0:09:25.75,Default,,0,0,0,,是啊
Dialogue: 0,0:09:25.98,0:09:27.47,Default,,0,0,0,,那傢伙的手段是這樣的
Dialogue: 0,0:09:27.94,0:09:33.00,Default,,0,0,0,,首先在會議上提出自己看不順眼的團體的預算削減以及部室縮小
Dialogue: 0,0:09:33.29,0:09:34.72,Default,,0,0,0,,強行讓其通過
Dialogue: 0,0:09:35.35,0:09:38.43,Default,,0,0,0,,山窮水盡的對手們剩下的方法只有一個
Dialogue: 0,0:09:39.56,0:09:41.79,Default,,0,0,0,,一發逆轉的食戟！
Dialogue: 0,0:09:44.27,0:09:47.41,Default,,0,0,0,,薙切在接受食戟挑戰的同時
Dialogue: 0,0:09:47.55,0:09:49.43,Default,,0,0,0,,會提出更為過分的要求
Dialogue: 0,0:09:49.69,0:09:52.72,Default,,0,0,0,,最後讓所有事都如她所願
Dialogue: 0,0:09:53.41,0:09:55.70,Default,,0,0,0,,如此往復擴充著自己的勢力
Dialogue: 0,0:09:56.41,0:10:01.30,Default,,0,0,0,,蓋研的部員們知道了這次的對手是薙切的手下之後
Dialogue: 0,0:10:02.55,0:10:03.76,Default,,0,0,0,,全員都跑了…
Dialogue: 0,0:10:04.87,0:10:07.37,Default,,0,0,0,,這學長好沒人望…
Dialogue: 0,0:10:08.15,0:10:10.81,Default,,0,0,0,,那對戰對手是薙切嗎
Dialogue: 0,0:10:11.13,0:10:11.79,Default,,0,0,0,,那…
Dialogue: 0,0:10:20.41,0:10:24.50,Default,,0,0,0,,果然比起改裝  直接拆了重建會更快
Dialogue: 0,0:10:24.83,0:10:26.40,Default,,0,0,0,,是嗎  那就這樣吧
Dialogue: 0,0:10:26.78,0:10:28.57,Default,,0,0,0,,水戶你什麼意思啊
Dialogue: 0,0:10:29.10,0:10:31.73,Default,,0,0,0,,當然是先來看看情況啦
Dialogue: 0,0:10:32.09,0:10:34.43,Default,,0,0,0,,反正結局已經註定
Dialogue: 0,0:10:36.39,0:10:38.37,Default,,0,0,0,,繪理奈大人說過了哦
Dialogue: 0,0:10:38.74,0:10:43.81,Default,,0,0,0,,蓋飯再怎麼研究說到底也只是B級的低級品
Dialogue: 0,0:10:44.18,0:10:47.40,Default,,0,0,0,,遠月不需要這種東西
Dialogue: 0,0:10:48.76,0:10:50.88,Default,,0,0,0,,不過你要是有自信能贏過我
Dialogue: 0,0:10:50.91,0:10:52.75,Default,,0,0,0,,那就另當別論了
Dialogue: 0,0:10:53.95,0:10:56.16,Default,,0,0,0,,主將先生  懂了嗎？
Dialogue: 0,0:10:56.57,0:10:59.19,Default,,0,0,0,,這種部沒有存留的必要
Dialogue: 0,0:11:00.89,0:11:01.79,Default,,0,0,0,,肉魅嗎…
Dialogue: 0,0:11:08.23,0:11:09.50,Default,,0,0,0,,我不是肉魅
Dialogue: 0,0:11:09.96,0:11:11.46,Default,,0,0,0,,你要敢再說一次…
Dialogue: 0,0:11:11.77,0:11:14.41,Default,,0,0,0,,難道她就是食戟的對手？
Dialogue: 0,0:11:14.76,0:11:16.08,Default,,0,0,0,,那傢伙誰啊
Dialogue: 0,0:11:16.57,0:11:17.69,Default,,0,0,0,,水戶郁魅同學
Dialogue: 0,0:11:18.21,0:11:20.46,Default,,0,0,0,,有著「肉類大師」這一外號的廚師
Dialogue: 0,0:11:21.20,0:11:23.60,Default,,0,0,0,,初中的時候就一直保持一流成績
Dialogue: 0,0:11:23.90,0:11:28.06,Default,,0,0,0,,尤其是有關肉類的課程評價從未低於過A的絕贊手藝
Dialogue: 0,0:11:28.72,0:11:32.18,Default,,0,0,0,,在肉類方面的造詣堪稱學校頂尖
Dialogue: 0,0:11:33.55,0:11:36.81,Default,,0,0,0,,所有食材都要在高貴的肉類面前屈服！
Dialogue: 0,0:11:39.27,0:11:41.48,Default,,0,0,0,,不管你做什麼樣的料理
Dialogue: 0,0:11:41.73,0:11:44.77,Default,,0,0,0,,都贏不了我的超高級肉的
Dialogue: 0,0:11:45.70,0:11:47.94,Default,,0,0,0,,我覺得僅僅因為食材的價位而沾沾自喜
Dialogue: 0,0:11:48.20,0:11:50.05,Default,,0,0,0,,可是有損廚師之名的
Dialogue: 0,0:11:53.57,0:11:58.93,Default,,0,0,0,,學長  這次食戟能交給我嗎
Dialogue: 0,0:11:59.62,0:12:00.86,Default,,0,0,0,,你是誰啊
Dialogue: 0,0:12:01.07,0:12:02.55,Default,,0,0,0,,非部內成員插手…
Dialogue: 0,0:12:03.68,0:12:06.55,Default,,0,0,0,,你是那個插班生？開學儀式上的
Dialogue: 0,0:12:07.84,0:12:10.12,Default,,0,0,0,,我本想跟你聊聊來著
Dialogue: 0,0:12:12.15,0:12:15.25,Default,,0,0,0,,在別人的食戟上出風頭
Dialogue: 0,0:12:15.69,0:12:18.07,Default,,0,0,0,,看來對你自己廚藝很有自信呢
Dialogue: 0,0:12:18.59,0:12:19.96,Default,,0,0,0,,那樣的話  就將主場給你…
Dialogue: 0,0:12:20.70,0:12:22.55,Default,,0,0,0,,來場肉料理對決也可以
Dialogue: 0,0:12:23.16,0:12:24.39,Default,,0,0,0,,反正我都會贏
Dialogue: 0,0:12:25.02,0:12:26.16,Default,,0,0,0,,你說什麼
Dialogue: 0,0:12:27.28,0:12:28.71,Default,S,0,0,0,,那要是你輸給我的話
Dialogue: 0,0:12:29.71,0:12:31.52,Default,S,0,0,0,,敢不敢滾出遠月？
Dialogue: 0,0:12:34.24,0:12:37.08,Default,,0,0,0,,這點膽量都沒有就別在那邊誇下海口…
Dialogue: 0,0:12:37.15,0:12:37.98,Default,,0,0,0,,沒問題啊
Dialogue: 0,0:12:38.15,0:12:38.69,Default,,0,0,0,,什麼
Dialogue: 0,0:12:39.23,0:12:41.44,Default,,0,0,0,,那要是我贏了的話
Dialogue: 0,0:12:42.60,0:12:43.70,Default,,0,0,0,,怎麼辦呢…
Dialogue: 0,0:12:44.36,0:12:45.42,Default,,0,0,0,,那你就加入蓋澆飯研究部吧
Dialogue: 0,0:12:48.02,0:12:51.45,Default,,0,0,0,,加入蓋飯研究部  為蓋澆飯文化的發展做貢獻
Dialogue: 0,0:12:51.92,0:12:53.79,Default,,0,0,0,,作為給這邊添麻煩的賠罪
Dialogue: 0,0:12:54.54,0:12:56.82,Default,,0,0,0,,真心想贏我嗎
Dialogue: 0,0:12:59.95,0:13:03.19,Default,,0,0,0,,各位工作人員  今天先請回吧
Dialogue: 0,0:13:06.53,0:13:09.93,Default,,0,0,0,,那我就在題目上讓你一下好了
Dialogue: 0,0:13:10.73,0:13:14.15,Default,,0,0,0,,主材料是肉  菜品是蓋澆飯
Dialogue: 0,0:13:14.74,0:13:16.43,Default,,0,0,0,,3天后開戰
Dialogue: 0,0:13:17.83,0:13:19.38,Default,,0,0,0,,幸平  為什麼？
Dialogue: 0,0:13:19.81,0:13:22.80,Default,,0,0,0,,高價肉就是一切這種話
Dialogue: 0,0:13:23.24,0:13:25.87,Default,,0,0,0,,作為小餐館繼承人的我可不能當做沒聽到啊
Dialogue: 0,0:13:26.65,0:13:27.73,Default,,0,0,0,,而且最重要的是
Dialogue: 0,0:13:28.34,0:13:30.25,Default,,0,0,0,,我覺得這個地方被拆掉很可惜啊
Dialogue: 0,0:13:31.30,0:13:32.49,Default,,0,0,0,,幸平
Dialogue: 0,0:13:33.16,0:13:34.23,Default,,0,0,0,,但是創真君
Dialogue: 0,0:13:34.49,0:13:36.06,Default,,0,0,0,,你有勝算嗎？
Dialogue: 0,0:13:38.39,0:13:39.34,Default,,0,0,0,,現在開始想
Dialogue: 0,0:13:39.37,0:13:41.06,Default,,0,0,0,,果然是這樣啊！
Dialogue: 0,0:13:41.92,0:13:45.69,Default,,0,0,0,,真是要感謝繪理奈大人把這個工作交給我呢
Dialogue: 0,0:13:46.43,0:13:51.34,Default,,0,0,0,,要讓那個得意忘形的插班生領略一下肉的快感
Dialogue: 0,0:13:51.93,0:13:56.11,0wrt,F,0,0,0,,{\fn方正字跡-童體硬筆字體\fs32\fsp-5\1c954350\3c000000\b1\bord0.1\frz8\pos(262,237)}意外地重…
Dialogue: 0,0:13:52.54,0:13:55.35,Default,,0,0,0,,往右點  再往右點  再往右點
Dialogue: 0,0:13:57.52,0:14:00.13,Default,,0,0,0,,幸平那傢伙到底在想什麼啊
Dialogue: 0,0:14:00.63,0:14:04.09,Default,,0,0,0,,已經在整個學園成為超熱門話題了！
Dialogue: 0,0:14:04.75,0:14:06.29,Default,,0,0,0,,悠姬  冷靜點
Dialogue: 0,0:14:06.39,0:14:08.46,Default,,0,0,0,,雖然說我也會全力幫忙的…
Dialogue: 0,0:14:08.83,0:14:11.37,Default,,0,0,0,,但是離開戰已經沒有多少時間了
Dialogue: 0,0:14:12.00,0:14:14.95,Default,,0,0,0,,那麼你要怎麼辦呢？創真君
Dialogue: 0,0:14:17.92,0:14:19.63,0wrt,F,0,0,0,,{\fn方正小標宋_GBK\bord0\an2\1cFCFEFE\b1\fs40\pos(640,703.334)}距離食戟還有2天
Dialogue: 0,0:14:19.63,0:14:21.59,0wrt,F,0,0,0,,{\fsp5\pos(1116,486.667)}作戰會議
Dialogue: 0,0:14:19.63,0:14:21.59,0wrt,F,0,0,0,,{\fsp5\fs25\pos(1090.666,541.667)}主題  {\r}蓋飯
Dialogue: 0,0:14:19.63,0:14:21.59,0wrt,F,0,0,0,,{\fsp5\fs25\pos(1090.666,578.667)}食材  {\r}肉{\1aFF}。
Dialogue: 0,0:14:20.19,0:14:23.62,Default,,0,0,0,,那之後我想了一整晚
Dialogue: 0,0:14:24.33,0:14:27.86,Default,,0,0,0,,肉魅是肉…特別是牛肉的專家
Dialogue: 0,0:14:28.37,0:14:31.01,Default,,0,0,0,,那我們就不能繼續在牛肉上糾結
Dialogue: 0,0:14:31.71,0:14:34.10,Default,,0,0,0,,比如親子蓋飯的雞肉
Dialogue: 0,0:14:34.73,0:14:36.17,Default,,0,0,0,,很符合這回的題目
Dialogue: 0,0:14:36.76,0:14:39.19,Default,,0,0,0,,盡可能不要和肉魅做同樣的菜比較好
Dialogue: 0,0:14:39.69,0:14:43.12,Default,,0,0,0,,原來如此  儘量用不同的種類嗎
Dialogue: 0,0:14:44.19,0:14:46.11,Default,,0,0,0,,田所有喜歡的蓋飯嗎？
Dialogue: 0,0:14:46.40,0:14:50.85,Default,,0,0,0,,也不知道算不算是蓋飯  也不知道是不是用肉
Dialogue: 0,0:14:51.12,0:14:54.04,Default,,0,0,0,,將扇貝放火上烤
Dialogue: 0,0:14:54.29,0:14:56.83,Default,,0,0,0,,到貝殼開裂的時候澆一點黃油和醬油
Dialogue: 0,0:14:57.19,0:15:01.26,Default,,0,0,0,,然後盛到熱乎乎的米飯上吃  超級好吃的
Dialogue: 0,0:15:01.41,0:15:04.16,Default,,0,0,0,,對呢  還可以做海鮮蓋飯的
Dialogue: 0,0:15:04.73,0:15:07.35,Default,,0,0,0,,都是幸平你說要用肉決勝負…
Dialogue: 0,0:15:07.62,0:15:11.54,Default,,0,0,0,,題目都已經決定好了就別在那邊糾結了
Dialogue: 0,0:15:12.26,0:15:14.77,Default,,0,0,0,,你根本不明白肉魅的強大
Dialogue: 0,0:15:15.63,0:15:19.34,Default,,0,0,0,,如果說連A5的牛肉都拿不出的話  根本沒有勝算！
Dialogue: 0,0:15:19.57,0:15:21.73,Default,,0,0,0,,{\1c21F4FB\3cF3FAFF\shad0\fs26\frz12.5\bord4\move(1002,424,942,437)}注：日文中「英語」和「A5」同音
Dialogue: 3,0:15:19.57,0:15:21.73,Default,,0,0,0,,{\1c21F4FB\3c001014\shad0\fs26\frz12.5\bord2\blur0.3\move(1002,424,942,437)}注：日文中「英語」和「A5」同音
Dialogue: 0,0:15:19.59,0:15:21.73,Default,,0,0,0,,英語？English？
Dialogue: 0,0:15:22.03,0:15:25.81,Default,,0,0,0,,A5好像是指牛肉的品質級別吧？
Dialogue: 0,0:15:26.05,0:15:26.75,Default,,0,0,0,,對
Dialogue: 0,0:15:30.67,0:15:34.15,Default,,0,0,0,,用來表示從解體的牛身上割下的肉的重量比
Dialogue: 0,0:15:34.81,0:15:35.90,Default,,0,0,0,,稱為出肉率等級
Dialogue: 0,0:15:36.32,0:15:38.65,Default,,0,0,0,,一共分為A到C三個等級
Dialogue: 0,0:15:39.45,0:15:43.15,Default,,0,0,0,,渣滓的量  肉的緊致程度
Dialogue: 0,0:15:43.51,0:15:46.56,Default,,0,0,0,,脂肪光澤等等各種條件來綜合判斷的肉類等級！
Dialogue: 0,0:15:46.91,0:15:49.08,Default,,0,0,0,,分有1到5級
Dialogue: 0,0:15:52.41,0:15:55.41,Default,,0,0,0,,在這兩個方面都獲得最高等級的牛肉
Dialogue: 0,0:15:56.21,0:15:57.99,Default,,0,0,0,,就是A5牛肉
Dialogue: 0,0:15:59.04,0:16:02.89,Default,,0,0,0,,我在學園的慶典上吃過肉魅做的牛排
Dialogue: 0,0:16:03.52,0:16:06.03,Default,,0,0,0,,那種…那種等級牛肉…
Dialogue: 0,0:16:06.89,0:16:07.55,Default,,0,0,0,,能夠喝下去！
Dialogue: 0,0:16:08.03,0:16:08.93,Default,P,0,0,0,,喝下去!?
Dialogue: 0,0:16:09.35,0:16:13.48,Default,,0,0,0,,沒錯  咬下去的瞬間  肉會變成美味的結晶
Dialogue: 0,0:16:13.88,0:16:15.86,Default,,0,0,0,,從喉頭直接滑下去
Dialogue: 0,0:16:16.51,0:16:18.76,Default,,0,0,0,,如果在飯店想點一份那樣的牛肉的話
Dialogue: 0,0:16:19.11,0:16:21.20,7note,,0,0,0,,注：福澤諭吉  明治時期思想家\N其肖像被印在一萬日元紙幣正面
Dialogue: 0,0:16:19.11,0:16:21.20,Default,,0,0,0,,不知道要花多少張諭吉啊
Dialogue: 0,0:16:21.97,0:16:24.66,Default,,0,0,0,,而且這也是一個要點
Dialogue: 0,0:16:25.16,0:16:27.11,Default,,0,0,0,,就是食戟所使用的肉
Dialogue: 0,0:16:27.62,0:16:30.04,Default,,0,0,0,,全部都得自己準備
Dialogue: 0,0:16:30.67,0:16:33.95,Default,,0,0,0,,素材的採購也是廚師的本事之一
Dialogue: 0,0:16:34.96,0:16:38.91,Default,,0,0,0,,水戶家族是大規模的肉批發商
Dialogue: 0,0:16:39.23,0:16:41.50,Default,,0,0,0,,在牛肉界更是舉足輕重
Dialogue: 0,0:16:42.34,0:16:45.12,Default,,0,0,0,,資金  設備  流水線
Dialogue: 0,0:16:45.88,0:16:51.15,Default,,0,0,0,,這些一起構築了肉魅最高品質的料理…
Dialogue: 0,0:16:53.30,0:16:55.51,Default,,0,0,0,,說著說著自己蔫了
Dialogue: 0,0:16:56.15,0:17:00.07,Default,,0,0,0,,真的能超越那麼高品質的肉嗎？
Dialogue: 0,0:17:02.07,0:17:04.73,Default,,0,0,0,,那個…我覺得
Dialogue: 0,0:17:06.03,0:17:07.39,Default,,0,0,0,,蓋研還是牛肉應戰吧
Dialogue: 0,0:17:07.75,0:17:08.37,Default,P,0,0,0,,什麼!?
Dialogue: 0,0:17:08.68,0:17:11.22,Default,,0,0,0,,幸平你有沒有在聽我說啊？
Dialogue: 0,0:17:11.56,0:17:12.60,Default,,0,0,0,,用牛肉的話根本不可能贏過肉魅…
Dialogue: 0,0:17:12.68,0:17:14.36,Default,,0,0,0,,小西學長你不也說過嗎
Dialogue: 0,0:17:14.86,0:17:17.08,Default,,0,0,0,,蓋飯是「快捷  好吃  便宜」的代言
Dialogue: 0,0:17:18.47,0:17:20.38,Default,,0,0,0,,肉魅正是看不起這點不是嗎？
Dialogue: 0,0:17:21.04,0:17:22.33,Default,,0,0,0,,要讓她認可蓋飯
Dialogue: 0,0:17:22.72,0:17:25.40,Default,,0,0,0,,不用牛肉做出的菜品打敗她就沒有意義啊
Dialogue: 0,0:17:25.91,0:17:28.22,Default,,0,0,0,,而且也用不著使用那種高級食材！
Dialogue: 0,0:17:28.68,0:17:30.07,Default,,0,0,0,,蓋飯的魅力並不在那裡
Dialogue: 0,0:17:31.69,0:17:35.85,Default,,0,0,0,,男…男人有時候也有即使曲折信念也要守護的東西
Dialogue: 0,0:17:36.13,0:17:37.85,Default,,0,0,0,,那就快點出發去買食材吧
Dialogue: 0,0:17:38.77,0:17:41.36,Default,,0,0,0,,蓋飯研究部剩多少會費？
Dialogue: 0,0:17:43.37,0:17:44.81,Default,,0,0,0,,這…這個呢
Dialogue: 0,0:17:47.41,0:17:48.21,Default,,0,0,0,,就這麼點？
Dialogue: 0,0:17:52.65,0:17:55.21,Default,,0,0,0,,只能用的我的生活費先墊著了！
Dialogue: 0,0:17:55.47,0:17:56.97,Default,,0,0,0,,餘額就這麼點了？
Dialogue: 0,0:17:57.07,0:17:58.13,8para,,0,0,0,,謝謝惠顧
Dialogue: 0,0:17:58.19,0:18:00.76,Default,U,0,0,0,,你的生活費我會適當地打給你的
Dialogue: 0,0:18:01.37,0:18:04.36,Default,,0,0,0,,適當是這意思？  是這個意思上的適當嗎
Dialogue: 0,0:18:07.80,0:18:09.06,Default,S,0,0,0,,這好像有點…
Dialogue: 0,0:18:10.15,0:18:11.11,Default,S,0,0,0,,麻煩了
Dialogue: 0,0:18:14.89,0:18:18.74,Default,,0,0,0,,這是過去蓋研的食譜集  或許能用得上
Dialogue: 0,0:18:19.06,0:18:20.45,Default,,0,0,0,,學長  還有這些
Dialogue: 0,0:18:20.54,0:18:23.09,Default,,0,0,0,,謝謝  那堆放那邊
Dialogue: 0,0:18:23.77,0:18:25.62,Default,,0,0,0,,好的！來做吧
Dialogue: 0,0:18:28.72,0:18:30.59,Default,,0,0,0,,做好了！拜託試吃一下
Dialogue: 0,0:18:31.13,0:18:33.69,Default,,0,0,0,,用牛肉代替豬肉做的炸牛肉蓋飯
Dialogue: 0,0:18:34.30,0:18:36.00,Default,,0,0,0,,在研究會的食譜上又花了點心思
Dialogue: 0,0:18:36.20,0:18:38.32,Default,,0,0,0,,把雞蛋和鵪鶉蛋打在一起
Dialogue: 0,0:18:38.52,0:18:39.67,Default,,0,0,0,,味道應該會更濃郁
Dialogue: 0,0:18:44.37,0:18:46.65,Default,,0,0,0,,不算壞  但是還不夠
Dialogue: 0,0:18:47.11,0:18:48.73,Default,,0,0,0,,放入嘴裡的時候衝擊力不夠
Dialogue: 0,0:18:49.39,0:18:52.13,Default,,0,0,0,,肉魅的料理  就好像會給舌尖一種衝擊
Dialogue: 0,0:18:52.49,0:18:55.02,Default,,0,0,0,,衝擊…那就是油了
Dialogue: 0,0:18:57.26,0:18:58.85,Default,,0,0,0,,將砂糖和牛脂一起燒制
Dialogue: 0,0:18:59.19,0:19:00.77,Default,,0,0,0,,然後再淋上雞蛋  日式牛肉蓋飯！
Dialogue: 0,0:19:05.07,0:19:07.65,Default,,0,0,0,,不  還是不行  高級美味的口感沒有出來
Dialogue: 0,0:19:08.11,0:19:10.02,Default,,0,0,0,,那就不用牛脂  換用…
Dialogue: 0,0:19:10.47,0:19:12.66,Default,,0,0,0,,那個…這份食譜怎麼樣？
Dialogue: 0,0:19:40.07,0:19:42.30,Default,,0,0,0,,前輩整個人又蔫成白色了！
Dialogue: 0,0:19:42.37,0:19:43.85,Default,,0,0,0,,快點往他身上澆水讓他起來！
Dialogue: 0,0:19:48.63,0:19:52.14,Default,,0,0,0,,把蓋研所有有價值的食譜都試了一遍
Dialogue: 0,0:19:52.85,0:19:55.49,Default,,0,0,0,,也絞盡腦汁改良了
Dialogue: 0,0:19:57.15,0:19:59.97,Default,,0,0,0,,創真  要不休息一下吧？
Dialogue: 0,0:20:00.99,0:20:06.27,Default,,0,0,0,,換一換心情  說不定就能像之前在課上那樣想到好辦法了
Dialogue: 0,0:20:06.91,0:20:07.55,Default,,0,0,0,,開玩笑的
Dialogue: 0,0:20:07.65,0:20:11.11,Default,,0,0,0,,你說用蜂蜜把肉煮鬆軟那次啊
Dialogue: 0,0:20:13.51,0:20:14.87,Default,,0,0,0,,創…創真君？
Dialogue: 0,0:20:15.59,0:20:17.14,Default,,0,0,0,,幫大忙了田所！
Dialogue: 0,0:20:17.59,0:20:22.15,Default,,0,0,0,,找到了  能讓一般價格的牛肉產生衝擊力的方法！
Dialogue: 0,0:20:22.81,0:20:24.31,Default,,0,0,0,,小西前輩  牛肉的部位的話
Dialogue: 0,0:20:24.35,0:20:26.24,Default,,0,0,0,,上腰肉也好牛臀肉也好  哪裡都行
Dialogue: 0,0:20:26.85,0:20:28.94,Default,,0,0,0,,還有沒有剩的牛排肉？
Dialogue: 0,0:20:30.45,0:20:31.47,Default,,0,0,0,,牛排？
Dialogue: 0,0:20:32.57,0:20:35.31,Default,,0,0,0,,首先在牛排上切出格紋
Dialogue: 0,0:20:35.87,0:20:37.10,Default,,0,0,0,,然後拍鬆
Dialogue: 0,0:20:38.16,0:20:41.94,Default,C,0,0,0,,把切碎的洋蔥敷在肉兩面  靜置一會兒
Dialogue: 0,0:20:42.91,0:20:46.59,Default,,0,0,0,,然後將洋蔥全部抹掉  撒上鹽和胡椒
Dialogue: 0,0:20:47.65,0:20:49.59,Default,,0,0,0,,將黃油燒化煎制牛肉
Dialogue: 0,0:20:50.53,0:20:53.27,Default,,0,0,0,,將洋蔥放入肉汁裡炒至入味
Dialogue: 0,0:20:55.75,0:20:56.64,Default,,0,0,0,,洋蔥…
Dialogue: 0,0:21:00.07,0:21:03.79,Default,,0,0,0,,把炒好的洋蔥滿鋪在肉上  完成了
Dialogue: 0,0:21:04.24,0:21:06.77,Default,,0,0,0,,這是…夏裡亞賓牛排！
Dialogue: 0,0:21:07.77,0:21:10.61,Default,,0,0,0,,歌劇歌手菲爾德雷夏裡亞賓訪日的時候
Dialogue: 0,0:21:10.91,0:21:14.69,Default,,0,0,0,,因為苦於牙痛說「想要吃軟一點的牛排」時
Dialogue: 0,0:21:15.14,0:21:16.76,Default,,0,0,0,,為滿足他的要求研究出的
Dialogue: 0,0:21:17.06,0:21:20.77,Default,,0,0,0,,只存在於日本的特別品種牛排
Dialogue: 0,0:21:22.01,0:21:24.31,Default,,0,0,0,,好了  你們兩都來嘗嘗吧
Dialogue: 0,0:21:38.50,0:21:40.32,Default,,0,0,0,,軟軟的
Dialogue: 0,0:21:40.90,0:21:42.32,Default,,0,0,0,,這是多麼柔軟
Dialogue: 0,0:21:42.79,0:21:44.28,Default,,0,0,0,,能用筷子輕易割開！
Dialogue: 0,0:21:46.75,0:21:48.96,Default,,0,0,0,,每咬一口  肉就在口中…
Dialogue: 0,0:21:49.30,0:21:53.30,Default,,0,0,0,,慢慢化開
Dialogue: 0,0:21:53.91,0:21:57.48,Default,,0,0,0,,洋蔥中含有分解蛋白質的酵素
Dialogue: 0,0:21:57.91,0:21:59.83,Default,,0,0,0,,就像鳳梨和蜂蜜一樣
Dialogue: 0,0:22:00.42,0:22:02.77,Default,,0,0,0,,所以肉才會這麼軟
Dialogue: 0,0:22:04.73,0:22:06.37,Default,,0,0,0,,根本不會認為是便宜的肉
Dialogue: 0,0:22:06.91,0:22:08.84,Default,,0,0,0,,肉的美味在口中蔓延開來
Dialogue: 0,0:22:09.80,0:22:11.70,Default,,0,0,0,,和米飯搭配的口感也剛剛好
Dialogue: 0,0:22:12.96,0:22:15.30,Default,,0,0,0,,可是  單憑這個…
Dialogue: 0,0:22:16.23,0:22:20.38,Default,,0,0,0,,真的能贏過肉魅的A5牛肉嗎
Dialogue: 0,0:23:53.72,0:23:57.46,Default,,0,0,0,,我所用的是黑毛和牛的裡脊肉
Dialogue: 0,0:23:58.17,0:24:00.31,Default,,0,0,0,,等級當然是A5
Dialogue: 0,0:24:01.02,0:24:04.53,Default,,0,0,0,,而且花費了一個月以上讓其成熟
Dialogue: 0,0:24:04.94,0:24:07.75,Default,,0,0,0,,比賽那天正是最美味的時候
Dialogue: 0,0:24:08.31,0:24:10.43,Default,,0,0,0,,可以說是超越A5的A5
Dialogue: 0,0:24:11.24,0:24:13.73,Default,,0,0,0,,我會用最能燒出鮮味的料理法
Dialogue: 0,0:24:14.11,0:24:16.83,Default,,0,0,0,,將蓋飯研究會一舉擊敗給您看
Dialogue: 0,0:24:17.67,0:24:18.81,Default,,0,0,0,,我很期待
Dialogue: 0,0:24:19.20,0:24:20.75,Default,,0,0,0,,那麼  先告辭了
Dialogue: 0,0:24:27.00,0:24:31.55,Default,,0,0,0,,幸平創真  能把你從遠月驅逐出去的機會
Dialogue: 0,0:24:32.21,0:24:35.16,Default,,0,0,0,,居然這麼早就到來了
Dialogue: 0,0:24:41.55,0:24:43.73,Default,,0,0,0,,下集  「食戟之靈」
Dialogue: 0,0:24:44.35,0:24:45.96,Default,,0,0,0,,第七道菜
Dialogue: 1,0:24:47.13,0:24:50.13,0wrt,F,0,0,0,,{\1c091414\3c091414\b1\bord0.2\pos(500.667,397.667)}菜\N單\N
Dialogue: 1,0:24:47.13,0:24:50.13,0wrt,F,0,0,0,,{\1c091414\3c091414\b1\bord0.2\pos(461.667,483.334)}沉\N靜\N的\N蓋\N澆\N飯
Dialogue: 1,0:24:47.13,0:24:50.13,0wrt,F,0,0,0,,{\1c091414\3c091414\b1\bord0.2\pos(419.667,534.334)}高\N談\N闊\N論\N的\N蓋\N澆\N飯
Dialogue: 0,0:24:47.57,0:24:50.17,Default,,0,0,0,,沉靜的蓋澆飯  高談闊論的蓋澆飯
Dialogue: 0,0:24:51.22,0:24:52.24,Default,,0,0,0,,敬請品嘗
Dialogue: 0,0:24:54.18,0:24:56.10,Default,,0,0,0,,多麼任性的身體
Dialogue: 1,0:00:21.62,0:00:26.84,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}生まれ変わる  今ここで
Dialogue: 1,0:00:27.05,0:00:32.30,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}仰いでいた  空越えていく
Dialogue: 1,0:00:32.55,0:00:43.44,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}握り締めた掌のその中に希望があったんだ
Dialogue: 1,0:00:47.69,0:00:52.78,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}目の前に広がる景色全部が
Dialogue: 1,0:00:53.11,0:00:57.83,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}実はちっぽけだったと気付いた
Dialogue: 1,0:00:58.37,0:01:03.04,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}例えば君と出會えば簡単に
Dialogue: 1,0:01:03.29,0:01:07.67,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}世界はひっくり返る
Dialogue: 1,0:01:08.67,0:01:14.59,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}知らないことだらけで  笑えてくるな
Dialogue: 1,0:01:14.84,0:01:20.89,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}まだまだ先に行ける証だ
Dialogue: 1,0:01:21.27,0:01:26.40,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}追いかけてた  遙か遠く
Dialogue: 1,0:01:26.73,0:01:31.94,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}ゆずれない思いも連れて
Dialogue: 1,0:01:32.15,0:01:43.04,opjp,,0,0,0,,{\fad(200,200)}{\3c00008C\1c82C0FF}誰も知らない頂を目指していく  全て懸けて
